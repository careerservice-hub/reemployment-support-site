{
  "name": "reemployment-support-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:popovers": "node scripts/check-popover-overflow.mjs",
    "check:business-inline": "node scripts/check-business-inline-details.mjs",
    "check:contact-form": "node scripts/check-contact-form.mjs",
    "check:consultation-worker": "node scripts/check-consultation-worker.mjs",
    "check:search-ai": "node scripts/check-recruitment-status.mjs && node scripts/check-public-copy.mjs && node scripts/check-search-ai-readiness.mjs",
    "submit:indexnow": "node scripts/submit-indexnow.mjs",
