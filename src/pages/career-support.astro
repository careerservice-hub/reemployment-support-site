---
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerSupportJsonLd } from '../data/structuredData.js';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const link = (path) => `${base}${path}`;

const supportFaqs = [
  {
    q: '경력지원서비스란 무엇인가요?',
    a: '경력지원서비스는 경력관리와 역량 향상, 경력전환 준비를 돕는 지원을 뜻합니다. 고용노동부는 2026년 5월 14일 재취업지원서비스를 가칭 경력지원서비스로 변경하는 방안을 발표했습니다. 발표된 개편 방향과 실제 시행 기준은 구분해 확인해야 합니다.',
  },
  {
    q: '경력지원서비스는 별도의 정부사업인가요?',
    a: '명칭 변경 추진이 별도 정부사업 신설이나 지원대상의 자동 확대를 뜻하지는 않습니다. 이 사이트의 기업컨설팅과 커리어플래닝서비스는 재취업지원서비스 시행지원의 해당 사업 안내와 모집공고를 기준으로 확인해야 합니다.',
  },
  {
    q: '재취업지원서비스 시행지원과 어떤 관계인가요?',
    a: '재취업지원서비스 시행지원은 기업의 운영체계 구축과 중장년의 경력설계 준비를 지원합니다. 경력지원서비스로의 명칭 변경 추진과 별개로, 신청할 때는 기업컨설팅과 커리어플래닝서비스의 대상·절차를 각각 확인해야 합니다.',
  },
  {
    q: '누가 경력지원서비스를 이용할 수 있나요?',
    a: '기업은 재취업지원서비스 도입·개선을 위한 기업컨설팅을, 중장년 재직자는 경력진단·설계를 위한 커리어플래닝서비스를 확인할 수 있습니다. 법정 의무대상 여부와 지원사업 참여자격은 서로 다르며, 기업 규모·재직 여부·연령·제외조건과 모집 상황에 따라 참여 가능 여부가 달라집니다.',
  },
  {
    q: '경력지원서비스는 무료인가요?',
    a: '경력지원서비스라는 명칭만으로 무료 지원이 보장되지는 않습니다. 기업컨설팅은 사업 선정 여부를, 커리어플래닝서비스는 참여기준 충족 여부를 먼저 확인해야 합니다. 지원 범위와 비용 조건은 해당 연도 공식 사업 안내와 운영 상황을 확인한 뒤 안내합니다.',
  },
  {
    q: '경력지원서비스는 어떻게 신청하나요?',
    a: '2026년 기업컨설팅은 6차까지 모집이 종료되었으며, 다음 사업 참여 준비를 위한 상담은 가능합니다. 차년도 일정과 신청자격은 공식 공고 후 확인해야 합니다. 개인은 커리어플래닝서비스 페이지에서 참여조건과 신청서류·제출 방법을 확인합니다. K·JOBS 상담 문의는 대상과 준비자료를 확인하기 위한 절차이며, 공식 신청·선정이나 참여 확정을 대신하지 않습니다.',
  },
];
const supportFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://www.careerservice.co.kr/career-support/#faq',
  mainEntity: supportFaqs.map(({ q, a }) => ({
    '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---
<BaseLayout title="경력지원서비스란? 대상·비용·신청 안내" description="경력지원서비스의 의미, 재취업지원서비스와의 관계와 명칭 변경 추진을 안내합니다. 기업컨설팅·커리어플래닝서비스의 대상, 비용 조건, 신청 절차를 확인하세요." jsonLd={[...careerSupportJsonLd, supportFaqJsonLd]}>
  <section class="ty-hero sub career-support-hero" aria-labelledby="career-support-title">
    <div class="ty-mark">경력지원서비스</div>
    <p class="ty-comment">명칭 변경 추진과 현재 이용 가능한 지원 안내</p>
    <h1 id="career-support-title">경력지원서비스란?<br />대상·비용·신청 방법을 안내합니다.</h1>
    <p class="ty-lead">경력지원서비스는 경력관리와 역량 향상, 경력전환 준비를 돕는 지원을 뜻합니다. 고용노동부가 발표한 가칭 ‘경력지원서비스’로의 명칭 변경 방향과, 재취업지원서비스 시행지원의 기업·개인 지원을 구분해 안내합니다.</p>
    <div class="ty-actions" aria-label="경력지원서비스 주요 이동">
      <a href={link('business-consulting/')}>기업 지원 확인</a>
      <a href={link('career-planning/')}>개인 지원 확인</a>
      <a href={link('contact/')}>상담 문의</a>
    </div>
  </section>

  <section class="ty-section" aria-labelledby="career-support-definition">
    <div class="ty-section-head">
      <p class="ty-comment">용어 안내</p>
      <h2 id="career-support-definition">경력지원서비스란?</h2>
      <p>퇴직 직전의 재취업 준비뿐 아니라 재직 중 경력 점검과 역량 향상까지 살펴보는 방향입니다. 아래는 K·JOBS가 안내하는 지원 내용이며, 모든 항목이 누구에게나 제공되거나 법정 의무 이행으로 인정된다는 뜻은 아닙니다.</p>
    </div>
    <div class="ty-feature-row four">
      <article><span>01</span><h3>경력진단</h3><p>직무경험, 보유역량, 강점과 관심 분야를 확인합니다.</p></article>
      <article><span>02</span><h3>경력설계</h3><p>계속근로, 역할 변화, 직무전환 등 다음 경력 방향을 정리합니다.</p></article>
      <article><span>03</span><h3>전환 준비</h3><p>역량 보완, 교육, 구직 준비 등 실행할 과제를 구체화합니다.</p></article>
      <article><span>04</span><h3>기업 제도화</h3><p>기업이 재취업지원서비스를 자체적으로 시행하고 개선할 수 있도록 절차, 담당자 역할과 관리기준을 마련합니다.</p></article>
    </div>
  </section>

  <section class="ty-section" aria-labelledby="official-name-relation">
    <div class="ty-note-panel">
      <div>
        <p class="ty-comment">공식 발표 2026.05.14 · 제도개선 추진</p>
        <h2 id="official-name-relation">재취업지원서비스와 어떤 관계인가요?</h2>
        <p class="ty-lead">고용노동부는 경력관리·역량 향상의 의미를 담아 ‘재취업지원서비스’를 가칭 ‘경력지원서비스’로 변경하는 방안을 발표했습니다. 첨부 제도개선 방안에는 고령자고용법 개정 추진이 제시되어 있습니다. 이 발표만으로 명칭 변경의 시행일이나 개인·기업의 지원자격이 확정되는 것은 아닙니다.</p>
        <p><a class="ty-inline-link" href="https://www.moel.go.kr/news/enews/report/enewsView.do?news_seq=19387" target="_blank" rel="noopener noreferrer">고용노동부 발표 원문·첨부자료</a></p>
        <p><a class="ty-inline-link" href={link('policy-updates/reemployment-service-reform-2026/')}>제도개선 방향과 적용 시 확인사항</a></p>
      </div>
      <div class="ty-checks">
        <p><strong>공식 안내</strong><span>재취업지원서비스 시행지원</span></p>
        <p><strong>기업 지원</strong><span>재취업지원서비스 기업컨설팅</span></p>
        <p><strong>개인 지원</strong><span>커리어플래닝서비스</span></p>
        <p><strong>변경 추진 명칭</strong><span>가칭 경력지원서비스</span></p>
      </div>
    </div>
  </section>

  <section class="ty-section" aria-labelledby="career-support-paths">
    <div class="ty-section-head">
      <p class="ty-comment">대상별 지원</p>
      <h2 id="career-support-paths">기업과 참여자의 준비를 구분해 지원합니다.</h2>
      <p>기업컨설팅과 커리어플래닝서비스는 목적과 대상이 다르지만, 지속 가능한 경력전환을 준비한다는 흐름에서 연결됩니다.</p>
    </div>
    <div class="ty-split-cards">
      <article>
        <span>기업의 제도화 기반 마련</span>
        <h3>기업컨설팅</h3>
        <p>기업 현황을 진단하고 운영체계 설계와 파일럿 검증을 거쳐 자체 시행과 반복 개선에 필요한 기준을 마련합니다.</p>
        <a href={link('business-consulting/')}>기업컨설팅 확인</a>
      </article>
      <article>
        <span>중장년 재직자의 경력설계</span>
        <h3>커리어플래닝서비스</h3>
        <p>직무경험과 보유역량을 점검하고 향후 역할, 경력목표와 실행계획을 상담 중심으로 정리합니다.</p>
        <a href={link('career-planning/')}>커리어플래닝서비스 확인</a>
      </article>
    </div>
  </section>

  <section class="ty-section" aria-labelledby="career-support-apply">
    <div class="ty-section-head">
      <p class="ty-comment">신청 전 확인</p>
      <h2 id="career-support-apply">대상과 비용 조건을 확인한 뒤 신청하세요.</h2>
      <p>지원사업 참여자격은 법정 의무대상 여부와 다릅니다. 명칭 변경 발표만으로 지원대상이나 무료 지원 범위가 확대되는 것은 아닙니다.</p>
    </div>
    <div class="ty-feature-row four">
      <article><span>01</span><h3>필요한 지원 선택</h3><p>제도 도입·개선을 준비하는 기업은 기업컨설팅을, 경력진단·설계가 필요한 중장년 재직자는 커리어플래닝서비스를 확인합니다.</p></article>
      <article><span>02</span><h3>대상·비용 확인</h3><p>기업 규모, 재직·연령 요건, 제외조건과 모집 상황을 확인합니다. 비용 지원은 사업 선정 또는 참여기준 충족 여부와 공식 지원 범위에 따라 확인해야 합니다.</p></article>
      <article><span>03</span><h3>서류 준비·신청</h3><p>선택한 서비스 페이지에서 신청서류와 공식 제출 경로를 확인합니다. 상담 문의는 공식 신청이나 선정 절차를 대신하지 않습니다.</p></article>
      <article><span>04</span><h3>진행 여부 확인</h3><p>접수 후 대상 여부, 준비자료와 운영 일정을 확인합니다. 상담 문의만으로 참여나 지원이 확정되지는 않습니다.</p></article>
    </div>
    <div class="ty-actions" aria-label="대상 및 신청 방법 확인">
      <a href={link('business-consulting/#recruitment-title')}>기업 모집 이력·참여 준비 상담</a>
      <a href={link('career-planning/#career-application-title')}>개인 참여조건·신청서류</a>
      <a href={link('faq/#common-faq-title')}>비용·신청 FAQ</a>
    </div>
  </section>

  <section class="ty-section faq-section" aria-labelledby="career-support-faq-title">
    <div class="ty-section-head">
      <p class="ty-comment">FAQ</p>
      <h2 id="career-support-faq-title">대상·비용·신청 전에 자주 묻는 질문</h2>
    </div>
    <div class="faq-list">
      {supportFaqs.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="ty-cta">
    <p class="ty-comment">기업과 개인의 상황에 따라 지원 범위가 달라질 수 있습니다</p>
    <h2>필요한 경력지원 방향부터 확인하세요.</h2>
    <a href={link('contact/')}>상담 문의하기</a>
  </section>
</BaseLayout>
