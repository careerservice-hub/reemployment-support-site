---
import BaseLayout from '../layouts/BaseLayout.astro';

const guideFaqs = [
  ['어떤 기업이 재취업지원서비스 기업컨설팅을 검토할 수 있나요?', '재취업지원서비스 의무대상기업, 제도를 처음 도입하는 기업, 기존 운영체계를 개선하려는 기업과 공동 운영을 검토하는 기업이 대상 여부를 확인할 수 있습니다. 실제 신청 가능 여부는 해당 연도와 차수별 공식 공고를 기준으로 판단합니다.'],
  ['기업컨설팅은 어떤 유형으로 진행되나요?', '제도 시행 경험과 운영 여건에 따라 기초컨설팅, 전문컨설팅, 공동컨설팅으로 구분됩니다. 기초는 기본 운영체계 구축, 전문은 기존 모델의 개선과 성과관리 고도화, 공동은 여러 기업의 공동 운영모델 설계에 초점을 둡니다.'],
  ['기업은 상담 전에 무엇을 준비하면 되나요?', '기업 규모와 50세 이상 근로자 현황, 퇴직예정자 발생 가능성, 기존 운영자료, 담당부서와 내부 의사결정 흐름, 희망 일정을 확인하면 초기 상담을 효율적으로 진행할 수 있습니다.'],
  ['기업컨설팅 비용은 얼마인가요?', '노사발전재단 재취업지원서비스 시행지원 사업으로 선정된 기업의 기업컨설팅 비용은 전액 무료입니다. 모집 일정과 지원 범위는 최신 공식 공고를 확인해야 합니다.'],
];
const guideJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: guideFaqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
const guidePageData = {
  dateModified: '2026-08-27',
  about: ['재취업지원서비스 기업컨설팅', '재취업지원서비스 컨설팅 대상', '기초컨설팅', '전문컨설팅', '공동컨설팅', '기업컨설팅 준비자료'],
};
---
<BaseLayout title="재취업지원서비스 기업컨설팅 안내" description="재취업지원서비스 기업컨설팅의 지원대상, 기초·전문·공동컨설팅 차이, 7단계 진행절차와 기업 준비자료를 한 번에 확인합니다." jsonLd={guideJsonLd} pageStructuredData={guidePageData}>
  <article class="policy-article business-guide">
    <header class="policy-article-header">
      <nav class="policy-breadcrumb" aria-label="현재 위치">
        <a href="/business-consulting/">재취업지원서비스 기업컨설팅</a><span aria-hidden="true">/</span><span>기업 담당자 안내</span>
      </nav>
      <p class="ty-comment">기업 담당자 종합 안내</p>
      <h1>재취업지원서비스 기업컨설팅,<br class="wide-break" /> 대상·유형·절차·준비자료를 확인하세요.</h1>
      <p class="ty-lead">처음 검토하는 기업도 신청 가능성부터 컨설팅 진행과 준비사항까지 한 흐름으로 이해할 수 있도록 핵심 기준을 정리했습니다.</p>
    </header>

    <aside class="policy-status-note" aria-label="최신 기준 확인 안내">
      <strong>먼저 확인하세요</strong>
      <p>기업컨설팅의 모집대상, 신청기간과 세부 지원범위는 연도와 차수에 따라 달라질 수 있습니다. 실제 신청 전에는 노사발전재단의 최신 공고와 상담 안내를 함께 확인해야 합니다.</p>
    </aside>

    <section class="policy-article-section" id="target">
      <p class="policy-section-label">01. 대상 확인</p>
      <h2>제도 도입·개선 또는 공동 운영이 필요한 기업이 검토할 수 있습니다.</h2>
      <div class="policy-fact-grid">
        <article><span>도입 준비</span><strong>기본 운영체계 마련</strong><p>재취업지원서비스를 처음 준비하거나 최근 시행 경험이 부족한 기업</p></article>
        <article><span>운영 개선</span><strong>기존 체계 고도화</strong><p>기존 서비스의 안내, 참여, 기록과 성과관리 방식을 개선하려는 기업</p></article>
        <article><span>공동 운영</span><strong>업종·지역·원하청 협력</strong><p>여러 기업이 대상자와 운영자원을 함께 고려해 공동모델을 마련하려는 경우</p></article>
      </div>
      <p>기업 규모는 전년도 월평균 고용보험 피보험자 수를 기준으로 확인합니다. 의무대상 여부뿐 아니라 대상자 발생 가능성, 기존 시행 경험과 기업의 운영 여건을 함께 살펴봐야 합니다.</p>
      <p><a class="ty-inline-link" href="/policy-updates/mandatory-employer-expansion-2026/">재취업지원서비스 의무사업장 기준과 확대 추진 내용 확인</a></p>
    </section>

    <section class="policy-article-section" id="types">
      <p class="policy-section-label">02. 유형 선택</p>
      <h2>기초·전문·공동컨설팅은 기업의 시행 경험과 운영 여건에 따라 달라집니다.</h2>
      <ol class="policy-checklist">
        <li><strong>기초컨설팅</strong><span>제도를 처음 준비하거나 시행 경험이 부족한 기업의 대상자 선정, 담당자 역할, 안내·운영 절차와 기본 관리체계를 설계합니다.</span></li>
        <li><strong>전문컨설팅</strong><span>기존 시행 경험 또는 전년도 기초컨설팅 결과를 바탕으로 프로그램 품질, 담당자 역량, 기록·성과관리와 사후관리 체계를 고도화합니다.</span></li>
        <li><strong>공동컨설팅</strong><span>업종·지역·원하청 관계 등 공통 여건을 가진 여러 기업이 대표사와 참여사의 역할을 나누고 공동 운영모델을 설계합니다.</span></li>
      </ol>
      <p><a class="ty-inline-link" href="/policy-updates/joint-consulting-pilot-2026/">재취업지원서비스 공동컨설팅 운영방식 확인</a></p>
    </section>

    <section class="policy-article-section" id="process">
      <p class="policy-section-label">03. 진행 절차</p>
      <h2>단일기업 컨설팅은 진단에서 파일럿과 제도설계까지 7단계로 진행됩니다.</h2>
      <div class="business-guide-steps" aria-label="재취업지원서비스 기업컨설팅 7단계">
        <span>착수</span><span>환경분석</span><span>계획수립</span><span>중간보고</span><span>파일럿 운영</span><span>제도설계</span><span>최종보고</span>
      </div>
      <p>기업 현황을 먼저 진단하고 초기 설계안을 기업과 점검한 뒤, 일부 대상자에게 파일럿을 실시해 현장 적용성을 확인합니다. 확인 결과는 담당자 역할, 대상자 선정, 서비스 구성, 기록과 성과관리 기준을 포함한 최종 운영체계에 반영합니다.</p>
      <p><a class="ty-inline-link" href="/business-consulting/#business-consulting-process">7단계별 재취업지원서비스 기업컨설팅 내용 보기</a></p>
    </section>

    <section class="policy-article-section" id="materials">
      <p class="policy-section-label">04. 준비자료</p>
      <h2>처음부터 모든 자료를 완성하기보다 현재 확인 가능한 현황을 준비하면 됩니다.</h2>
      <ol class="policy-checklist">
        <li><strong>기업과 대상자 현황</strong><span>전년도 고용보험 가입인원, 연령별 근로자 수, 퇴직예정자 수와 예상 시점</span></li>
        <li><strong>담당체계</strong><span>조직도, 인사·노무 담당자, 내부 결재선, 노사협의 필요 여부</span></li>
        <li><strong>기존 운영자료</strong><span>기존 교육·상담 프로그램, 참여자 안내문, 개인정보 동의와 증빙관리 양식</span></li>
        <li><strong>파일럿 여건</strong><span>참여 가능 대상자, 근무일정, 운영장소, 담당자와 현장 책임자</span></li>
      </ol>
      <p>초기 상담에서는 민감한 인사자료나 퇴직자 명단을 제출할 필요가 없습니다. 먼저 자료 보유 여부와 확인 가능한 범위를 협의하고, 필요한 자료와 개인정보 처리기준을 정리한 뒤 진행합니다.</p>
    </section>

    <section class="policy-article-section" id="results">
      <p class="policy-section-label">05. 결과 활용</p>
      <h2>기업이 다음 운영에도 반복 활용할 수 있는 시행기준을 남깁니다.</h2>
      <div class="policy-fact-grid">
        <article><span>현황 진단</span><strong>현재 수준과 쟁점</strong><p>바로 실행할 수 있는 부분과 추가 정리가 필요한 과제를 구분합니다.</p></article>
        <article><span>운영체계</span><strong>역할·절차·기록</strong><p>대상자 안내, 서비스 운영, 증빙과 담당자 역할을 실행 순서로 정리합니다.</p></article>
        <article><span>개선 과제</span><strong>파일럿 결과 반영</strong><p>현장 의견과 참여 결과를 바탕으로 다음 운영주기의 보완사항을 남깁니다.</p></article>
      </div>
    </section>

    <section class="policy-article-section business-guide-faq" aria-labelledby="guide-faq-title">
      <p class="policy-section-label">자주 묻는 질문</p>
      <h2 id="guide-faq-title">기업이 검토 단계에서 자주 확인하는 내용입니다.</h2>
      {guideFaqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </section>

    <section class="policy-source-box" aria-labelledby="guide-source-title">
      <h2 id="guide-source-title">공식 기준과 다음 단계</h2>
      <p>고용노동부 재취업지원서비스 운영 매뉴얼과 노사발전재단의 기업컨설팅 사업 안내를 기준으로 확인하고, 모집 일정과 세부 요건은 최신 공고를 우선 적용합니다.</p>
      <div class="policy-actions">
        <a class="btn primary" href="/business-consulting/">기업컨설팅 지원내용 확인</a>
        <a class="btn secondary" href="/contact/#consultation-request">기업 대상·준비자료 상담</a>
      </div>
      <p><a class="ty-inline-link" href="https://www.moel.go.kr/policy/policydata/view.do?bbs_seq=20250401955" target="_blank" rel="noopener noreferrer">고용노동부 재취업지원서비스 운영 매뉴얼</a></p>
      <p><a class="ty-inline-link" href="https://www.nosa.or.kr/portal/nosa/majorBiz/reEmpymnSport/entrprsCnsl" target="_blank" rel="noopener noreferrer">노사발전재단 재취업지원서비스 기업컨설팅 안내</a></p>
    </section>
  </article>

  <style>
    .business-guide-steps { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 8px; margin: 24px 0; }
    .business-guide-steps span { padding: 14px 8px; border: 1px solid rgba(18,116,123,.16); border-radius: 12px; background: #f4f9f9; color: #27545a; font-size: .88rem; font-weight: 750; text-align: center; }
    .business-guide-faq { display: grid; gap: 10px; }
    .business-guide-faq > h2, .business-guide-faq > .policy-section-label { margin-bottom: 4px; }
    .business-guide-faq details { border: 1px solid rgba(18,116,123,.14); border-radius: 16px; background: #fff; }
    .business-guide-faq summary { padding: 18px 20px; color: #29434d; font-weight: 750; cursor: pointer; }
    .business-guide-faq details p { margin: 0; padding: 0 20px 20px; color: #51656d; line-height: 1.68; }
    @media (max-width: 900px) { .business-guide-steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    @media (max-width: 560px) { .business-guide-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  </style>
</BaseLayout>
