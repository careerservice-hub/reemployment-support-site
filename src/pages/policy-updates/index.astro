---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { experimental_AstroContainer as AstroContainer } from 'astro/container';

// Render the existing articles at build time so search follows their full content.
const articlePages = import.meta.glob(['./*.astro', '!./index.astro'], { eager: true });
const container = await AstroContainer.create();

const articles = [
  {
    id: 7,
    href: '/policy-updates/excellent-companies-2026/',
    category: '우수기업 선정 사례',
    title: '2026년 재취업지원서비스 우수기업 선정: 공동 운영과 근로자 선택 중심의 제도화 사례',
    summary: '선정기업의 공동 운영, 교육·상담 결합과 참여시간 보장 사례를 살펴보고, 기업이 점검할 운영 책임과 지속 조건을 정리했습니다.',
    sourceDate: '원자료 발표 2026.09.15',
  },
  {
    id: 6,
    href: '/policy-updates/labor-culture-employment-retention-2026/',
    category: '고용유지·인력운영 사례',
    title: '노사문화 대상 후보사업장 사례로 살펴본 고용유지와 중장년 인력운영',
    summary: '수상 확정 전 후보자료에 담긴 전환배치·역할 조정·노사협의 사례를 살펴보고, 기업의 경험 활용과 경력설계 지원을 위한 점검사항을 정리했습니다.',
    sourceDate: '원자료 발표 2026.09.10',
  },
  {
    id: 5,
    href: '/policy-updates/enterprise-course-budget-2027/',
    category: '정부 예산안',
    title: '2027년 재취업지원서비스 기업과정 신설 추진: 정부 예산안에 담긴 기업 지원 방향',
    summary: '고용노동부가 2027년 예산안에 재취업지원서비스 기업과정 신설 계획을 담았습니다. 예산안의 지원 방향과 기업이 후속 공고에서 확인할 사항을 정리했습니다.',
    sourceDate: '보도자료 발표 2026.09.04',
  },
  {
    id: 4,
    href: '/policy-updates/naver-it-joint-consulting-2026/',
    source: '노사발전재단 · 고용노동부 게시',
    category: '공동컨설팅 사례',
    title: 'IT 업종 재취업지원서비스 확산 추진: 네이버·노사발전재단 공동컨설팅 협력',
    summary: '노사발전재단과 네이버가 추진하는 IT 업종 상생형 공동컨설팅의 내용과 중소기업이 확인할 적용 방향을 정리했습니다.',
    sourceDate: '보도자료 발표 2026.08.19',
  },
  {
    id: 2,
    href: '/policy-updates/joint-consulting-pilot-2026/',
    category: '기업컨설팅 운영',
    title: '재취업지원서비스 공동컨설팅 도입: 중소기업 공동 운영모델의 시작',
    summary: '2026년 처음 시범 운영된 공동컨설팅의 대상과 운영방식, 중소기업이 확인할 사항을 정리했습니다.',
    sourceDate: '정책자료 발표 2026.05.22',
  },
  {
    id: 1,
    href: '/policy-updates/reemployment-service-reform-2026/',
    category: '재취업지원서비스 제도',
    title: '재취업지원서비스 제도개선 5가지 핵심: 노동자 선택과 기업 지원',
    summary: '고용노동부가 발표한 제도개선 방안의 5대 과제와 기업·중장년 근로자가 확인할 사항을 정리했습니다.',
    sourceDate: '정책 발표 2026.05.14',
  },
  {
    id: 3,
    href: '/policy-updates/mandatory-employer-expansion-2026/',
    category: '재취업지원서비스 제도',
    title: '재취업지원서비스 의무사업장 확대 추진: 기업이 미리 확인할 사항',
    summary: '고용노동부가 발표한 시행령 개정안의 핵심과 500인 이상 기업이 준비할 사항을 정리했습니다.',
    sourceDate: '정책자료 발표 2026.05.29',
  },
];
const searchableArticles = await Promise.all(articles.map(async (article) => {
  const slug = article.href.split('/').filter(Boolean).at(-1);
  const page = articlePages[`./${slug}.astro`];
  const html = await container.renderToString(page.default, {
    request: new Request(new URL(article.href, Astro.site)),
  });
  // Main contains one outer policy article, which may contain nested article cards.
  const main = html.match(/<main\b[^>]*>([\s\S]*?)<\/main>/)?.[1] ?? '';
  const content = main.match(/<article class="policy-article"[^>]*>([\s\S]*)<\/article>/)?.[1];
  if (!content) throw new Error(`Missing policy article body: ${article.href}`);
  const source = article.source ?? content.match(/<dt>발표기관<\/dt>\s*<dd>([\s\S]*?)<\/dd>/)?.[1];
  if (!source) throw new Error(`Missing policy source institution: ${article.href}`);
  return { ...article, date: article.sourceDate.match(/\d{4}\.\d{2}\.\d{2}/)[0].replaceAll('.', '-'),
    source: source.replace(/<[^>]+>/g, ' ').trim(),
    body: content.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim() };
}));
searchableArticles.sort((a, b) => b.date.localeCompare(a.date));
const policyListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'K·JOBS 정책·제도 업데이트',
  numberOfItems: articles.length,
  itemListElement: articles.map((article, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: article.title,
    url: new URL(article.href, 'https://www.careerservice.co.kr').toString(),
  })),
};
const policyCollectionData = {
  about: ['재취업지원서비스', '재취업지원서비스 기업컨설팅', '중장년 경력지원'],
  hasPart: articles.map((article) => ({
    '@type': 'Article',
    headline: article.title,
    url: new URL(article.href, 'https://www.careerservice.co.kr').toString(),
  })),
};
---
<BaseLayout title="정책·제도 업데이트" description="재취업지원서비스 의무사업장, 제도개선, 기업컨설팅과 커리어플래닝서비스 관련 정책 변화를 기업 실무 관점에서 설명합니다." jsonLd={policyListJsonLd} pageType="CollectionPage" pageStructuredData={policyCollectionData}>
  <section class="ty-hero sub policy-hero">
    <div class="ty-mark">POLICY UPDATE</div>
    <p class="ty-comment">정책 변화와 기업의 준비사항을 안내합니다</p>
    <h1>정책·제도 업데이트</h1>
    <p class="ty-lead">고용노동부와 관계기관의 공식 자료를 바탕으로 재취업지원서비스 제도 변화와 기업의 준비사항을 안내합니다. 출처와 확인 기준일도 함께 제공합니다.</p>
  </section>

  <section class="policy-board" aria-label="정책 자료 검색 및 목록">
    <form id="policy-search-form" role="search" hidden>
      <label for="policy-search">정책 자료 검색</label>
      <div class="search-controls">
        <input id="policy-search" type="search" placeholder="제목, 요약, 본문으로 검색" autocomplete="off" />
        <button type="submit">검색</button>
        <button type="button" id="policy-reset">초기화</button>
      </div>
      <p class="search-note">제목·요약·본문 전체에서 검색합니다.</p>
    </form>
    <div class="board-meta">
      <p id="policy-result-count" role="status" aria-live="polite" aria-atomic="true">전체 <strong>{articles.length}</strong>건</p>
      <span>원자료 발표일 최신순</span>
    </div>
    <div class="list-head" aria-hidden="true"><span>번호</span><span>정책 자료</span><span>발표기관</span><span>원자료 발표일</span></div>
    <div id="policy-list">
      {searchableArticles.map((article) => (
        <article class="policy-row" data-search={article.body}>
          <span class="policy-number" aria-label={`게시글 번호 ${article.id}`}>{article.id}</span>
          <div class="policy-main">
            <h2><a href={article.href}>{article.title}</a></h2>
            <span class="policy-tag">{article.category}</span>
            <p class="policy-summary" title={article.summary}>{article.summary}</p>
          </div>
          <span class="policy-source">{article.source}</span>
          <time datetime={article.date}><span class="mobile-label">원자료 발표 </span>{article.date.replaceAll('-', '.')}</time>
        </article>
      ))}
    </div>
    <div id="policy-empty" hidden><h2>검색 결과가 없습니다.</h2><p>다른 검색어를 입력하거나 초기화해 주세요.</p></div>
    <nav id="policy-pagination" aria-label="정책 목록 페이지" hidden></nav>
    <p id="policy-page-info"></p>
  </section>

  <section class="ty-section policy-principles" aria-labelledby="policy-principles-title">
    <div class="ty-section-head">
      <p class="ty-comment">자료 확인 기준</p>
      <h2 id="policy-principles-title">공식 자료를 바탕으로 기업이 확인할 핵심을 정리합니다.</h2>
    </div>
    <div class="policy-principle-grid">
      <article><strong>공식 자료 확인</strong><p>자료명, 발표기관, 발표일과 원문 링크를 함께 제공합니다.</p></article>
      <article><strong>시행 단계 확인</strong><p>정책방안·입법예고·개정안·확정 법령을 구분하고 확인 기준일을 표시합니다.</p></article>
      <article><strong>기업 준비사항</strong><p>기업 담당자가 준비할 절차와 점검사항을 중심으로 설명합니다. 지원사업 신청자격과 일정은 <a href="/business-consulting/#recruitment-title">기업컨설팅 모집 안내</a>를, 신청 전 준비와 담당자 역할은 <a href="/faq/#consulting-faq-title">기업컨설팅 FAQ</a>를 확인하세요.</p></article>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#policy-search-form')!;
  const input = document.querySelector<HTMLInputElement>('#policy-search')!;
  const pagination = document.querySelector<HTMLElement>('#policy-pagination')!;
  const rows = [...document.querySelectorAll<HTMLElement>('.policy-row')];
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase('ko-KR').replace(/\s+/g, ' ').trim();
  const decoder = document.createElement('textarea');
  const records = rows.map(row => {
    decoder.innerHTML = row.dataset.search ?? '';
    return { row, text: normalize(`${row.textContent} ${decoder.value}`) };
  });
  const pageSize = 10;
  let currentPage = 1;
  function render(focusPage = false) {
    const query = normalize(input.value);
    const terms = query.split(' ').filter(Boolean);
    const matched = records.filter(record => terms.every(term => record.text.includes(term)));
    const pages = Math.max(1, Math.ceil(matched.length / pageSize));
    currentPage = Math.max(1, Math.min(currentPage, pages));
    rows.forEach(row => { row.hidden = true; });
    matched.slice((currentPage - 1) * pageSize, currentPage * pageSize).forEach(({ row }) => { row.hidden = false; });
    document.querySelector('#policy-result-count')!.textContent = `${query ? '검색 결과' : '전체'} ${matched.length}건`;
    document.querySelector<HTMLElement>('#policy-empty')!.hidden = matched.length > 0;
    pagination.replaceChildren();
    pagination.hidden = matched.length === 0;
    const addButton = (label: string, target: number, disabled = false, current = false) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = label;
      button.disabled = disabled;
      button.setAttribute('aria-label', `${label} 페이지`);
      if (current) button.setAttribute('aria-current', 'page');
      button.addEventListener('click', () => { currentPage = target; render(true); });
      pagination.append(button);
    };
    if (matched.length) {
      addButton('이전', currentPage - 1, currentPage === 1);
      for (let page = 1; page <= pages; page++) addButton(String(page), page, false, currentPage === page);
      addButton('다음', currentPage + 1, currentPage === pages);
    }
    document.querySelector('#policy-page-info')!.textContent = matched.length ? `${currentPage} / ${pages} 페이지` : '';
    if (focusPage) pagination.querySelector<HTMLButtonElement>('[aria-current="page"]')?.focus();
  }
  input.addEventListener('input', () => { currentPage = 1; render(); });
  form.addEventListener('submit', event => { event.preventDefault(); currentPage = 1; render(); });
  document.querySelector('#policy-reset')!.addEventListener('click', () => { input.value = ''; currentPage = 1; render(); input.focus(); });
  form.hidden = false;
  render();
</script>

<style>
  .ty-hero.sub.policy-hero { min-height: 0; padding: 46px 0 34px; border: 0; }
  .policy-hero .ty-mark { font-size: 24px; margin-bottom: 14px; }
  .policy-hero .ty-comment { margin-bottom: 16px; }
  .policy-hero .ty-lead { font-size: 18px; margin-top: 22px; }
  .policy-board { max-width: 1040px; margin: 0 auto 18px; }
  .policy-board [hidden] { display: none !important; }
  #policy-search-form { padding-top: 16px; }
  label { display: block; font-size: 14px; font-weight: 650; margin-bottom: 10px; }
  .search-controls { display: flex; gap: 8px; }
  input { flex: 1; min-width: 0; width: 100%; min-height: 52px; border: 1px solid #d2d2d7; border-radius: 10px; padding: 12px 16px; font: inherit; font-size: 16px; background: white; color: #1d1d1f; }
  button { cursor: pointer; font: inherit; }
  .search-controls button { min-height: 52px; border: 1px solid #06c; border-radius: 10px; padding: 0 26px; background: #06c; color: white; font-size: 15px; font-weight: 600; }
  #policy-reset { background: transparent; border-color: #d2d2d7; color: #515154; }
  .search-note { font-size: 12px; color: #6e6e73; margin-top: 8px; }
  .board-meta { display: flex; justify-content: space-between; align-items: center; margin: 28px 0 14px; gap: 12px; }
  #policy-result-count { font-size: 14px; }
  .board-meta > span { font-size: 12px; color: #6e6e73; }
  .list-head, .policy-row { display: grid; grid-template-columns: 40px minmax(0, 1fr) 132px 118px; gap: 24px; align-items: center; }
  .list-head { border-top: 1px solid #1d1d1f; border-bottom: 1px solid #d2d2d7; padding: 12px 0; font-size: 12px; color: #6e6e73; }
  .policy-row { padding: 21px 0; border-bottom: 1px solid #dedee3; }
  .policy-number { color: #6e6e73; font-size: 13px; text-align: center; font-variant-numeric: tabular-nums; }
  .policy-tag { display: inline-block; margin-top: 7px; padding: 3px 8px; border-radius: 5px; background: #eaf3ff; color: #0057ad; font-size: 11px; line-height: 1.5; }
  .policy-main { min-width: 0; }
  .policy-main h2 { font-size: 17px; letter-spacing: -.025em; line-height: 1.55; font-weight: 650; text-wrap: initial; color: #1d1d1f; }
  .policy-main h2 a:hover { color: #06c; text-decoration: underline; text-underline-offset: 4px; }
  .policy-summary { font-size: 13px; color: #6e6e73; margin-top: 5px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.6; }
  .policy-source, time { font-size: 12px; color: #6e6e73; line-height: 1.6; }
  .mobile-label { display: none; }
  #policy-empty { text-align: center; padding: 64px 16px; border-bottom: 1px solid #dedee3; }
  #policy-empty h2 { font-size: 18px; }
  #policy-empty p { margin-top: 8px; font-size: 14px; color: #6e6e73; }
  #policy-pagination { display: flex; justify-content: center; flex-wrap: wrap; gap: 6px; margin-top: 28px; }
  #policy-pagination :global(button) { min-width: 44px; min-height: 44px; padding: 0 12px; border: 1px solid #d2d2d7; border-radius: 8px; background: white; color: #515154; font: inherit; font-size: 14px; cursor: pointer; }
  #policy-pagination :global(button[aria-current="page"]) { background: #06c; color: white; border-color: #06c; }
  #policy-pagination :global(button:disabled) { opacity: .45; cursor: default; }
  #policy-page-info { text-align: center; margin-top: 10px; font-size: 12px; color: #6e6e73; }
  .policy-board :global(:focus-visible) { outline: 2px solid #06c; outline-offset: 3px; }
  @media (max-width: 700px) {
    .ty-hero.sub.policy-hero { padding: 32px 0 26px; }
    .policy-hero .ty-mark { font-size: 18px; margin-bottom: 10px; }
    .policy-hero .ty-lead { font-size: 15px; margin-top: 16px; }
    .search-controls { flex-wrap: wrap; }
    .search-controls input { flex-basis: 100%; }
    .search-controls button { flex: 1; min-height: 46px; }
    .list-head { display: none; }
    #policy-list { border-top: 1px solid #1d1d1f; }
    .policy-row { grid-template-columns: 1fr auto; gap: 8px 12px; padding: 19px 0; }
    .policy-number { grid-column: 1 / -1; text-align: left; font-size: 11px; }
    .policy-number::before { content: "No. "; }
    .policy-main { grid-column: 1 / -1; }
    .policy-main h2 { font-size: 16px; }
    .policy-source, time { font-size: 11px; }
    .mobile-label { display: inline; }
    .board-meta { margin-top: 22px; }
  }
</style>
