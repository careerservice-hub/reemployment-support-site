---
import BaseLayout from '../../layouts/BaseLayout.astro';

const sourceUrl = 'https://www.moel.go.kr/news/enews/report/enewsView.do?news_seq=19799';
const sourcePdfUrl = 'https://www.moel.go.kr/common/downloadFile.do?file_seq=20260801041&bbs_seq=19799&bbs_id=12&file_ext=pdf';
const canonicalUrl = 'https://www.careerservice.co.kr/policy-updates/naver-it-joint-consulting-2026/';
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'IT 업종 재취업지원서비스 확산 추진: 네이버·노사발전재단 공동컨설팅 협력',
  description: '노사발전재단과 네이버가 추진하는 IT 업종 상생형 공동컨설팅의 주요 내용과 중소기업이 확인할 적용 방향을 설명합니다.',
  datePublished: '2026-08-20',
  dateModified: '2026-08-20',
  inLanguage: 'ko-KR',
  mainEntityOfPage: canonicalUrl,
  author: { '@type': 'Organization', name: '케이잡스 K·JOBS' },
  publisher: { '@id': 'https://www.careerservice.co.kr/#organization' },
  about: ['IT 업종 재취업지원서비스', '네이버 노사발전재단 업무협약', '재취업지원서비스 공동컨설팅', '중소 IT기업 중장년 고용안정'],
  citation: sourceUrl,
};
---
<BaseLayout title="IT 업종 재취업지원서비스 공동컨설팅 협력" description="노사발전재단과 네이버의 IT 업종 재취업지원서비스 공동컨설팅 협력 내용과 중소기업이 확인할 적용 방향을 안내합니다." jsonLd={articleJsonLd}>
  <article class="policy-article">
    <header class="policy-article-header">
      <nav class="policy-breadcrumb" aria-label="현재 위치">
        <a href="/policy-updates/">정책·제도 업데이트</a><span aria-hidden="true">/</span><span>공동컨설팅 사례</span>
      </nav>
      <p class="ty-comment">공동컨설팅 사례</p>
      <h1>IT 업종 재취업지원서비스 확산 추진:<br class="wide-break" /> 네이버·노사발전재단 공동컨설팅 협력</h1>
      <p class="ty-lead">노사발전재단과 네이버가 대기업의 운영 경험과 공공의 지원체계를 연계해 중소 IT기업의 재취업지원서비스 운영을 돕는 협력에 나섰습니다.</p>
      <div class="policy-date-row">
        <span>보도자료 발표 2026.08.19</span>
        <span>확인 기준 2026.08.20</span>
      </div>
    </header>

    <aside class="policy-status-note" aria-label="협약 진행단계 안내">
      <strong>먼저 확인하세요</strong>
      <p>이번 발표는 양 기관이 체결한 <b>업무협약과 향후 추진방향</b>에 관한 내용입니다. 중소 IT기업의 운영 역량 향상이나 재취업 성과가 이미 확인됐다는 의미는 아니며, 구체적인 참여대상과 운영일정은 노사발전재단의 후속 안내를 확인해야 합니다.</p>
    </aside>
    <p><a class="ty-inline-link" href="/policy-updates/joint-consulting-pilot-2026/">재취업지원서비스 공동컨설팅의 제도와 운영방식 먼저 보기</a></p>

    <section class="policy-article-section">
      <p class="policy-section-label">협약 내용</p>
      <h2>IT 업종에 맞는 운영 경험을 중소기업과 공유하는 협력체계가 마련됐습니다.</h2>
      <p>노사발전재단과 네이버는 2026년 8월 19일 「IT 산업 재취업지원서비스 확산 및 중장년 고용안정 지원을 위한 업무협약」을 체결했습니다.</p>
      <div class="policy-fact-grid">
        <article><span>협력 방식</span><strong>상생형 공동컨설팅</strong><p>대기업의 운영 경험과 노사발전재단의 기업컨설팅 지원체계를 연계합니다.</p></article>
        <article><span>적용 분야</span><strong>IT 업종 특화</strong><p>빠른 직무 변화와 경력전환 수요를 고려한 재취업지원서비스 모델 확산을 추진합니다.</p></article>
        <article><span>확산 대상</span><strong>중소 IT기업</strong><p>개별적으로 운영체계를 갖추기 어려운 기업의 실무역량 강화를 지원하는 방향입니다.</p></article>
      </div>
      <p>공식 보도자료는 네이버가 노사발전재단의 기업컨설팅을 바탕으로 IT 업종 특화 재취업지원서비스 모델을 구축했고, 해당 성과로 2025년 고용노동부 장관상을 수상했다고 설명합니다. 이번 협약은 그 운영 경험을 중소 IT기업으로 확산하기 위한 후속 협력에 해당합니다.</p>
    </section>

    <section class="policy-article-section">
      <p class="policy-section-label">공동컨설팅의 의미</p>
      <h2>한 기업의 프로그램을 그대로 복제하기보다 업종 공통요구와 기업별 여건을 함께 반영해야 합니다.</h2>
      <p>공동컨설팅은 여러 기업이 같은 교육을 일괄 수강하는 방식에 한정되지 않습니다. 업종의 직무변화와 경력전환 수요를 공통 기반으로 삼되, 기업별 대상자 규모, 담당부서, 근무형태와 기존 지원제도를 확인해 실제 운영 가능한 기준을 설계해야 합니다.</p>
      <ol class="policy-checklist">
        <li><strong>업종 공통수요 확인</strong><span>IT 직무 변화, 재교육과 경력전환 수요 중 참여기업이 함께 다룰 항목을 구분합니다.</span></li>
        <li><strong>기업별 대상 확인</strong><span>퇴직예정자 규모와 발생시기, 직무와 근무형태를 기업별로 확인합니다.</span></li>
        <li><strong>공동·개별 영역 구분</strong><span>공통 교육과 업종정보는 함께 운영하고, 개인상담과 실행계획은 기업·참여자 여건에 맞게 조정합니다.</span></li>
        <li><strong>운영주체와 역할 정리</strong><span>참여기업, 대표 운영주체와 수행기관의 일정·안내·기록관리 책임을 구분합니다.</span></li>
        <li><strong>파일럿 후 보완</strong><span>소규모 시범운영 결과를 바탕으로 참여방식과 관리기준을 보완합니다.</span></li>
      </ol>
    </section>

    <section class="policy-article-section">
      <p class="policy-section-label">기업 확인사항</p>
      <h2>협약 발표만으로 참여가 확정되는 것은 아니므로 후속 모집기준을 확인해야 합니다.</h2>
      <p>IT기업이 공동컨설팅 참여를 검토한다면 공식 모집 여부, 참여기업 구성, 대표 운영주체, 지원범위와 파일럿 조건을 먼저 확인해야 합니다. 내부적으로는 재취업지원서비스 담당부서와 대상자 현황, 기존 교육·상담제도, 공동 운영에 제공할 수 있는 자료와 역할을 정리해 두는 것이 필요합니다.</p>
    </section>

    <section class="policy-article-section policy-kjobs-view">
      <p class="policy-section-label">K·JOBS 해설</p>
      <h2>업종형 공동컨설팅은 공통모델과 기업별 실행체계를 함께 설계할 때 활용도가 높아집니다.</h2>
      <p>업종 공통모델은 참여기업이 참고할 기준을 제공하지만, 실제 시행을 위해서는 각 기업의 대상자 확인, 안내절차, 담당자 역할, 서비스 제공과 증빙관리 방식이 별도로 정리돼야 합니다.</p>
      <p>K·JOBS 기업컨설팅은 기업 현황 진단, 공동 운영구조 설계, 파일럿 운영과 개선과제 정리를 통해 참여기업이 이후 자체적으로 운영할 수 있는 기준 마련을 지원합니다.</p>
      <div class="policy-actions">
        <a class="btn primary" href="/business-consulting/">기업컨설팅 확인</a>
        <a class="btn secondary" href="/contact/">공동컨설팅 문의</a>
      </div>
    </section>

    <section class="policy-source-box" aria-labelledby="source-title">
      <h2 id="source-title">자료 출처</h2>
      <dl>
        <div><dt>원자료</dt><dd>노사발전재단, 「노사발전재단–네이버, IT 업종 재취업지원서비스 확산 위해 맞손」</dd></div>
        <div><dt>게시기관</dt><dd>고용노동부</dd></div>
        <div><dt>발표일</dt><dd>2026년 8월 19일</dd></div>
      </dl>
      <p>고용노동부에 게시된 노사발전재단 보도자료를 바탕으로 협약의 진행단계, 공동컨설팅과의 관계와 기업이 확인할 사항을 정리했습니다.</p>
      <a class="ty-inline-link" href={sourceUrl} target="_blank" rel="noopener noreferrer">고용노동부 보도자료 확인</a>
      <a class="ty-inline-link" href={sourcePdfUrl} target="_blank" rel="noopener noreferrer">보도자료 PDF 확인</a>
    </section>
  </article>
</BaseLayout>
