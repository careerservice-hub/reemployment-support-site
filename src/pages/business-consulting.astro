---
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessConsultingJsonLd } from '../data/structuredData.js';
import BusinessInlineDetails from '../components/BusinessInlineDetails.astro';
const readinessItems = [
  ['재취업지원서비스 도입 또는 개선을 검토하는 기업', '처음 도입하는 기업은 기본 운영체계를, 이미 운영 중인 기업은 안내·참여·성과관리 방식의 개선점을 중심으로 점검합니다.'],
  ['대상자 규모, 내부 역할, 운영 절차를 정리해야 하는 기업', '퇴직예정자 규모와 발생 시점, 담당 부서 역할, 내부 결재·안내 흐름을 먼저 정리해야 실행 가능한 제도 설계가 가능합니다.'],
  ['담당자 안내, 참여자 모집, 일정 운영 방식을 구체화하려는 기업', '현장 담당자가 바로 설명할 수 있는 안내 문구, 참여자 모집 방식, 회차별 일정 운영 기준을 기업 상황에 맞게 구체화합니다.'],
  ['파일럿 운영을 통해 현장 적용 가능성을 확인하려는 기업', '일부 대상자에게 먼저 적용해 안내문, 상담 흐름, 산출물 정리 방식이 실제 사업장에서 작동하는지 확인합니다.'],
];
const steps = [
  ['01', '착수', '기업 현황과 컨설팅 범위를 확인하고 진행 기준을 맞춥니다.', '담당자, 케이잡스, 컨설턴트가 컨설팅 목적과 범위를 함께 확인합니다. 이후 일정, 자료 준비, 주요 의사결정 지점을 정리해 전체 진행 기준을 맞춥니다.'],
  ['02', '환경분석', '제도 운영 여건, 대상자 규모, 내부 준비 수준을 진단합니다.', '기업의 인력구조, 대상자 발생 가능성, 기존 지원제도, 담당 조직을 확인합니다. 이 단계의 진단 결과가 계획수립과 파일럿 범위를 정하는 기준이 됩니다.'],
  ['03', '계획수립', '기업 상황에 맞는 컨설팅 일정과 운영 방향을 정리합니다.', '방문 일정, 인터뷰·FGI 범위, 참여자 안내 방식, 중간 점검 시점을 정합니다. 기업 여건에 맞는 운영 방향을 문서화해 실행 가능한 계획으로 바꿉니다.'],
  ['04', '중간보고', '진단 결과와 설계 방향을 점검하고 보완 과제를 확인합니다.', '환경분석 결과와 초기 설계안을 공유하고 기업 의견을 반영합니다. 이후 파일럿 운영과 제도설계에서 보완해야 할 쟁점을 확정합니다.'],
  ['05', '파일럿운영', '설계한 서비스 흐름을 일부 대상자에게 시범 적용합니다.', '설계한 서비스 흐름을 일부 대상자에게 적용해 안내문, 상담 절차, 결과 정리 방식의 운영 가능성을 점검합니다.'],
  ['06', '제도설계', '기업이 자체 시행할 수 있는 운영체계와 절차를 구체화합니다.', '담당 부서 역할, 대상자 선정, 프로그램 구성, 기록·성과관리 방식을 정리합니다. 기업이 이후 자체적으로 시행할 수 있는 운영 기준을 남깁니다.'],
  ['07', '최종보고', '자체 시행과 반복 개선을 위한 제도화 기준을 정리합니다.', '진단과 파일럿에서 확인한 내용을 담당자 역할, 운영 절차, 기록·성과관리 기준과 다음 운영주기의 개선과제로 정리합니다. 기업이 이후에도 자체적으로 시행하고 개선할 수 있는 최종 산출물로 마무리합니다.'],
];
const supportTypes = [
  ['기초컨설팅', '시행 경험이 없거나 최근 3년간 실시 경험이 없는 기업의 도입·운영체계 구축을 지원합니다.', '제도를 처음 준비하거나 법령 요건에 적합한 서비스를 제공하지 못한 기업이 대상입니다. 제도 이해, 담당자 역할, 대상자 안내 방식, 기본 운영 흐름을 잡는 데 초점을 둡니다.'],
  ['전문컨설팅', '시행 경험이 있는 기업의 개선사항 진단, 전담인력 역량강화, 운영체계 강화, 성과관리를 점검합니다.', '기존 운영 경험이 있거나 전년도 기초컨설팅에 참여한 기업이 대상입니다. 기존 성과를 계승해 제도 개선, 담당자 역량, 프로그램 품질, 성과관리 기준을 고도화합니다.'],
  ['공동컨설팅', '원·하청 관계사와 중소산업단지 기업이 공동 운영 여건에 맞춰 참여합니다.', '100인 이상 기업이 1개소 이상 참여하면 100인 미만 기업도 함께 신청할 수 있습니다. 현황분석·수요조사, 서비스 제공, 최종 결과보고의 3단계로 조정합니다.'],
];
const practicalChecks = [
  {
    title: '의무기업 여부와 대상자 발생 가능성',
    body: '전년도 고용보험 피보험자 수, 50세 이상 근로자 현황, 퇴직예정자 발생 시점을 먼저 확인합니다.',
    criteria: ['전년도 월평균 고용보험 피보험자 수', '연령대별 근로자 수와 전체 근로자 대비 비율', '해당 연도 퇴직예정자 수와 예상 퇴직 시점', '향후 1~3년간 예상되는 대상자 규모'],
    materials: '고용보험 가입인원 자료, 연령별 인원 현황, 퇴직예정자 인원 집계표',
  },
  {
    title: '담당부서와 내부 의사결정 흐름',
    body: '인사·노무 담당자, 결재선, 노사협의 필요 여부를 정리해 안내와 실행이 끊기지 않게 합니다.',
    criteria: ['제도 운영을 담당할 부서와 실무담당자', '시행계획과 예산을 승인하는 내부 결재선', '참여자 안내와 일정을 조정할 현장 책임자', '노사협의회 또는 노동조합 협의 필요 여부'],
    materials: '조직도, 업무분장표, 내부 결재 절차, 노사협의회 운영 현황',
  },
  {
    title: '서비스 제공 방식과 증빙관리 기준',
    body: '상담·교육·취업알선 등 제공 방식, 참여 안내, 결과물 보관, 만족도 확인 절차를 함께 점검합니다.',
    criteria: ['진로설계·취업알선·취·창업교육·복합제공 중 적합한 유형', '집체교육·개별상담·온라인·대면 등 운영 방식', '참여 대상자 선정과 안내·동의 절차', '상담일지·출석부·교육사진·만족도 조사 등 증빙자료'],
    materials: '기존 교육·상담 자료, 참여자 안내문, 개인정보 동의서, 증빙관리 양식',
  },
  {
    title: '파일럿 운영으로 확인할 현장 쟁점',
    body: '참여자 모집, 일정 운영, 상담 흐름, 결과 정리 방식이 실제 사업장에서 작동하는지 소규모로 확인합니다.',
    criteria: ['파일럿 참여자 모집 가능 여부와 적정 인원', '근무시간·교대근무를 고려한 일정 편성', '상담·교육 장소와 참여시간 확보 가능 여부', '참여자 의견·만족도 확인과 후속 보완 방식'],
    materials: '대상자 후보, 근무일정, 운영장소, 참여 안내계획, 만족도 조사양식',
  },
];
const outputItems = [
  ['운영 현황 진단', '대상자, 준비 수준, 내부 의사결정 필요사항을 구분합니다.', '현재 기업이 바로 실행할 수 있는 부분과 추가 정리가 필요한 부분을 나눠 이후 제도설계의 기준으로 삼습니다.'],
  ['제도화 실행안', '담당자 역할, 운영 절차, 참여자 안내, 파일럿 운영 흐름을 정리합니다.', '담당자가 실제로 사용할 수 있도록 실행 순서, 안내 문구, 일정 운영, 산출물 정리 방식을 포함합니다.'],
  ['최종 개선 과제', '파일럿 결과와 현장 의견을 바탕으로 후속 보완사항을 제시합니다.', '한 번의 컨설팅으로 끝내지 않고 다음 운영 주기에 반영할 개선 과제와 우선순위를 남깁니다.'],
];
---
<BaseLayout title="재취업지원서비스 기업컨설팅" description="2026년 기업컨설팅 모집은 6차까지 종료되었습니다. 다음 사업 참여 준비 상담, 제도 도입·개선 절차와 참여기업 담당자 연수를 안내합니다." jsonLd={businessConsultingJsonLd}>
  <section class="ty-hero sub">
    <div class="ty-mark">기업컨설팅</div>
    <p class="ty-comment">기업의 자체 시행과 반복 개선 지원</p>
    <h1 class="business-title">재취업지원서비스 기업컨설팅으로<br />기업이 자체 시행하고 개선할 수 있는 제도화 기반을 마련합니다.</h1>
    <p class="ty-lead">기업의 현황과 기존 시행 경험을 진단하고, 운영체계 설계와 파일럿 검증을 거쳐<br class="wide-break" /> 재취업지원서비스를 지속적으로 시행·개선할 수 있는 기반을 마련합니다.</p>
    <div class="mobile-quick-card service" aria-label="기업컨설팅 모바일 핵심 안내">
      <span>기업 담당자 확인사항</span>
      <strong>제도 운영 전에 다음 항목을 확인하세요.</strong>
      <ul>
        <li>의무기업 여부와 대상자 발생 가능성 확인</li>
        <li>담당부서·내부 결재 흐름 정리</li>
        <li>파일럿 운영으로 현장 적용성 점검</li>
      </ul>
      <a href="/contact/">기업컨설팅 문의하기</a>
    </div>
  </section>

  <section class="ty-section page-next-actions business-guide-entry" aria-labelledby="business-guide-entry-title">
    <div class="ty-note-panel">
      <div>
        <p class="ty-comment">기업 담당자 빠른 안내</p>
        <h2 id="business-guide-entry-title">재취업지원서비스 기업컨설팅을 처음 검토하나요?</h2>
        <p>지원대상, 기초·전문·공동컨설팅의 차이, 7단계 진행절차와 기업 준비자료를 한 페이지에서 확인할 수 있습니다.</p>
        <p><a href="#company-staff-training">참여기업 담당자 연수 확인</a></p>
      </div>
      <div class="page-next-actions-grid" aria-label="기업컨설팅 상세 안내">
        <a class="primary" href="/business-consulting-guide/">
          <strong>기업컨설팅 종합 안내</strong>
          <span>대상·유형·절차·준비자료 확인</span>
        </a>
        <a href="/faq/#consulting-faq-title">
          <strong>기업컨설팅 FAQ</strong>
          <span>비용·기간·신청 전 질문 확인</span>
        </a>
        <a href="/contact/#consultation-request">
          <strong>신청 전 상담</strong>
          <span>기업 상황과 준비자료 확인</span>
        </a>
      </div>
    </div>
  </section>

  <section class="ty-section recruitment-notice" aria-labelledby="recruitment-title">
    <div class="ty-section-head">
      <p class="ty-comment">2026년 기업컨설팅 모집 안내</p>
      <h2 id="recruitment-title">올해 모집은 마감되었습니다. 다음 사업 참여를 미리 준비하세요.</h2>
      <p>2026년 기업컨설팅은 6차까지 모집이 종료되었습니다. 다음 사업 참여를 검토 중이라면 연락처를 남겨 주세요. 담당자가 기업의 제도 운영 현황과 컨설팅 필요사항을 상담하고, 미리 준비할 내용을 안내해 드립니다.</p>
    </div>
    <div class="recruitment-actions">
      <a class="primary" href="/contact/?preset=business-next-year#consultation-request">차년도 참여 준비 상담받기</a>
    </div>
    <p class="recruitment-source">사전상담은 공식 사업 신청이 아닙니다. 차년도 모집 일정과 참여조건은 공식 공고 후 확인할 수 있습니다.</p>
    <details class="recruitment-details" id="recruitment-history">
      <summary>2026년 모집 이력 보기</summary>
      <table class="recruitment-history-table">
        <caption>2026년 기업컨설팅 차수별 공고</caption>
        <thead><tr><th scope="col">모집공고</th><th scope="col">선정공고</th></tr></thead>
        <tbody>
            <tr><td><a href="https://www.nosa.or.kr/board/read.brd?boardId=nosa05&amp;bltnNo=11773634627231" target="_blank" rel="noopener noreferrer" aria-label="1차 모집공고 (새 창)"><strong>1차 모집공고</strong><span>3. 16. ↗</span></a></td><td><a href="https://www.nosa.or.kr/board/read.brd?boardId=nosa05&amp;bltnNo=11776393950070" target="_blank" rel="noopener noreferrer" aria-label="1차 선정공고 (새 창)"><strong>1차 선정공고</strong><span>4. 17. ↗</span></a></td></tr>
            <tr><td><a href="https://www.nosa.or.kr/board/read.brd?boardId=nosa05&amp;bltnNo=11776645941501" target="_blank" rel="noopener noreferrer" aria-label="2차 모집공고 (새 창)"><strong>2차 모집공고</strong><span>4. 20. ↗</span></a></td><td><a href="https://www.nosa.or.kr/board/read.brd?boardId=nosa05&amp;bltnNo=11779411159512" target="_blank" rel="noopener noreferrer" aria-label="2차 선정공고 (새 창)"><strong>2차 선정공고</strong><span>5. 22. ↗</span></a></td></tr>
