---
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessConsultingJsonLd } from '../data/structuredData.js';

const steps = [
  ['01', '착수', '기업 현황과 컨설팅 범위를 확인하고 진행 기준을 맞춥니다.', '담당자, 케이잡스, 컨설턴트가 컨설팅 목적과 범위를 함께 확인합니다. 이후 일정, 자료 준비, 주요 의사결정 지점을 정리해 전체 진행 기준을 맞춥니다.'],
  ['02', '환경분석', '제도 운영 여건, 대상자 규모, 내부 준비 수준을 진단합니다.', '기업의 인력구조, 대상자 발생 가능성, 기존 지원제도, 담당 조직을 확인합니다. 이 단계의 진단 결과가 계획수립과 파일럿 범위를 정하는 기준이 됩니다.'],
  ['03', '계획수립', '기업 상황에 맞는 컨설팅 일정과 운영 방향을 정리합니다.', '방문 일정, 인터뷰·FGI 범위, 참여자 안내 방식, 중간 점검 시점을 정합니다. 기업 여건에 맞는 운영 방향을 문서화해 실행 가능한 계획으로 바꿉니다.'],
  ['04', '중간보고', '진단 결과와 설계 방향을 점검하고 보완 과제를 확인합니다.', '환경분석 결과와 초기 설계안을 공유하고 기업 의견을 반영합니다. 이후 파일럿 운영과 제도설계에서 보완해야 할 쟁점을 확정합니다.'],
  ['05', '파일럿운영', '설계한 운영 흐름의 현장 작동 여부를 제한적으로 확인합니다.', '기업이 자체 시행할 수 있도록 설계한 흐름을 일부 대상자에게 제한적으로 적용해 안내, 상담 절차, 결과 정리 방식의 운영 가능성을 점검합니다.'],
  ['06', '제도설계', '기업이 자체 시행할 수 있는 운영체계와 절차를 구체화합니다.', '담당 부서 역할, 대상자 선정, 프로그램 구성, 기록·성과관리 방식을 정리합니다. 기업이 이후 자체적으로 시행할 수 있는 운영 기준을 남깁니다.'],
  ['07', '최종보고', '실행 결과, 개선사항, 제도화 과제를 최종 정리합니다.', '컨설팅 결과, 파일럿 운영 확인사항, 보완 과제, 향후 실행 일정을 정리합니다. 내부 보고와 후속 운영에 활용할 수 있는 최종 산출물로 마무리합니다.'],
];
const supportTypes = [
  {
    label: '처음 도입하거나 기본체계를 정리해야 할 때',
    title: '기초컨설팅',
    situation: '시행 경험이 없거나 최근 3년간 적정한 서비스를 실시하지 못한 기업',
    focus: '대상자 확인, 담당자 역할, 참여 안내, 기본 운영 절차를 정리합니다.',
  },
  {
    label: '기존 운영을 개선하고 고도화해야 할 때',
    title: '전문컨설팅',
    situation: '시행 경험이 있거나 전년도 기초컨설팅 결과를 발전시키려는 기업',
    focus: '기존 성과를 계승해 담당자 역량, 프로그램 품질, 성과관리 기준을 고도화합니다.',
  },
  {
    label: '관계사와 함께 운영기반을 마련해야 할 때',
    title: '공동컨설팅',
    situation: '원·하청 관계사 또는 중소산업단지 기업이 공동 참여를 검토하는 경우',
    focus: '참여기업의 업무 연계성과 현장 여건을 반영해 공동 운영방식을 설계합니다.',
  },
];
const practicalChecks = [
  {
    title: '의무기업 여부와 대상자 발생 가능성',
    body: '전년도 고용보험 피보험자 수, 50세 이상 근로자 현황, 퇴직예정자 발생 시점을 먼저 확인합니다.',
    criteria: ['전년도 월평균 고용보험 피보험자 수', '연령대별 근로자 수와 전체 근로자 대비 비율', '해당 연도 퇴직예정자 수와 예상 퇴직 시점', '향후 1~3년간 예상되는 대상자 규모'],
    materials: '고용보험 가입인원 자료, 연령별 인원 현황, 퇴직예정자 인원 집계표',
  },
  {
    title: '담당부서와 내부 의사결정 흐름',
    body: '인사·노무 담당자, 결재선, 노사협의 필요 여부를 정리해 안내와 실행이 끊기지 않게 합니다.',
    criteria: ['제도 운영을 담당할 부서와 실무담당자', '시행계획과 예산을 승인하는 내부 결재선', '참여자 안내와 일정을 조정할 현장 책임자', '노사협의회 또는 노동조합 협의 필요 여부'],
    materials: '조직도, 업무분장표, 내부 결재 절차, 노사협의회 운영 현황',
  },
  {
    title: '서비스 제공 방식과 증빙관리 기준',
    body: '상담·교육·취업알선 등 제공 방식, 참여 안내, 결과물 보관, 만족도 확인 절차를 함께 점검합니다.',
    criteria: ['진로설계·취업알선·취·창업교육·복합제공 중 적합한 유형', '집체교육·개별상담·온라인·대면 등 운영 방식', '참여 대상자 선정과 안내·동의 절차', '상담일지·출석부·교육사진·만족도 조사 등 증빙자료'],
    materials: '기존 교육·상담 자료, 참여자 안내문, 개인정보 동의서, 증빙관리 양식',
  },
  {
    title: '파일럿 운영으로 확인할 현장 쟁점',
    body: '참여자 모집, 일정 운영, 상담 흐름, 결과 정리 방식이 실제 사업장에서 작동하는지 소규모로 확인합니다.',
    criteria: ['파일럿 참여자 모집 가능 여부와 적정 인원', '근무시간·교대근무를 고려한 일정 편성', '상담·교육 장소와 참여시간 확보 가능 여부', '참여자 의견·만족도 확인과 후속 보완 방식'],
    materials: '대상자 후보, 근무일정, 운영장소, 참여 안내계획, 만족도 조사양식',
  },
];
const outputItems = [
  ['운영 현황 진단', '대상자, 준비 수준, 내부 의사결정 필요사항을 구분합니다.', '현재 기업이 바로 실행할 수 있는 부분과 추가 정리가 필요한 부분을 나눠 이후 제도설계의 기준으로 삼습니다.'],
  ['제도화 실행안', '담당자 역할, 운영 절차, 참여자 안내, 파일럿 운영 흐름을 정리합니다.', '담당자가 실제로 사용할 수 있도록 실행 순서, 안내 문구, 일정 운영, 산출물 정리 방식을 포함합니다.'],
  ['최종 개선 과제', '파일럿 확인사항과 현장 의견을 바탕으로 후속 보완사항을 제시합니다.', '한 번의 컨설팅으로 끝내지 않고 다음 운영 주기에 반영할 개선 과제와 우선순위를 남깁니다.'],
];
---
<BaseLayout title="재취업지원서비스 기업컨설팅" description="기업이 재취업지원서비스를 자체 제도화하고 시행할 수 있도록 현황 진단, 운영체계 설계와 파일럿 검증을 지원합니다." jsonLd={businessConsultingJsonLd}>
  <section class="ty-hero sub">
    <div class="ty-mark">기업컨설팅</div>
    <p class="ty-comment">기업의 자체 운영체계 설계</p>
    <h1 class="business-title">재취업지원서비스 기업컨설팅으로<br />기업 안에서 작동하는 시행체계를 설계합니다.</h1>
    <p class="ty-lead">기업이 재취업지원서비스를 자체적으로 시행할 수 있도록<br class="wide-break" /> 현황 진단부터 계획 수립, 운영체계 설계와 파일럿 검증까지 지원합니다.</p>
  </section>

  <section class="ty-section recruitment-notice" aria-labelledby="recruitment-title">
    <div class="ty-section-head">
      <p class="ty-comment">2026년 5차 모집</p>
      <h2 id="recruitment-title">기업컨설팅 지원사업장을 모집합니다.</h2>
      <p>신청 가능 여부를 확인하고, 공식 접수 단계에서 수행기관으로 케이잡스를 선택할 수 있습니다.</p>
    </div>
    <div class="recruitment-summary" aria-label="기업컨설팅 5차 모집 핵심 일정">
      <p><strong>신청기간</strong><span>2026. 7. 27.~8. 21.</span></p>
      <p><strong>지원대상</strong><span>100~999인 기업 우선</span></p>
      <p><strong>컨설팅 비용</strong><span>전액 무료</span></p>
    </div>
    <p class="recruitment-period">컨설팅 기간: 2026. 8. 31.~11. 20. · 기업 규모는 전년도 월평균 고용보험 피보험자 수 기준</p>
    <details class="recruitment-details">
      <summary>신청자격과 준비서류 확인</summary>
      <div class="recruitment-detail-grid">
        <div>
          <h3>신청대상</h3>
          <p>1,000인 이상 의무대상기업과 원·하청 관계사·중소산업단지 공동참여 기업도 신청할 수 있습니다. 공동컨설팅은 100인 이상 기업이 1개소 이상 참여하면 100인 미만 기업도 함께 참여할 수 있습니다.</p>
        </div>
        <div>
          <h3>준비서류</h3>
          <p>신청서, 사업자등록증, 고용보험 완납증명원, 300인 미만 기업의 2025년도 월별 피보험자 수 증빙, 개인정보 활용동의서를 준비합니다.</p>
        </div>
        <div>
          <h3>신청제한</h3>
          <p>행정기관, 최근 3년간 체불사업주 명단 공개 사업장, 중대산업재해 또는 산업재해 발생건수 등 공표기업은 신청할 수 없습니다.</p>
        </div>
      </div>
    </details>
    <div class="recruitment-actions">
      <a href="https://www.nosa.or.kr/portal/nosa/majorBiz/reEmpymnSport/entrprsCnsl" target="_blank" rel="noopener noreferrer">노사발전재단 공식 신청 안내</a>
      <a class="primary" href="/contact/">케이잡스 신청 전 상담</a>
    </div>
    <p class="recruitment-source">기준: 노사발전재단 2026년 「재취업지원서비스 기업컨설팅」 지원사업장 5차 모집 공고(2026. 7. 27.)</p>
  </section>

  <section class="ty-section business-direction" aria-labelledby="business-direction-title">
    <div class="ty-section-head">
      <p class="ty-comment">우리 회사에 맞는 지원 방향</p>
      <h2 id="business-direction-title">현재 운영 상황부터 선택해 보세요.</h2>
      <p>시행 경험과 참여 방식에 따라 검토할 컨설팅 유형이 달라집니다. 정확한 신청유형은 공식 기준과 기업 현황을 확인한 뒤 안내합니다.</p>
    </div>
    <div class="business-direction-grid">
      {supportTypes.map(({ label, title, situation, focus }) => (
        <article class="business-direction-card">
          <p class="business-direction-label">{label}</p>
          <h3>{title}</h3>
          <dl>
            <div>
              <dt>이런 기업</dt>
              <dd>{situation}</dd>
            </div>
            <div>
              <dt>지원 초점</dt>
              <dd>{focus}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
    <div class="business-direction-action">
      <p>유형을 바로 판단하기 어렵다면 기업 규모와 시행 경험부터 함께 확인합니다.</p>
      <a href="/contact/">기업컨설팅 신청 전 상담</a>
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-section-head">
      <h2>7단계로 제도화 가능성을 확인합니다.</h2>
      <p>단일기업 컨설팅은 평균 12주 동안 7단계로 진행됩니다. 공동컨설팅은 참여기업 여건에 따라 현황분석·수요조사, 서비스 제공, 최종 결과보고의 3단계로 조정합니다.</p>
    </div>
    <div class="ty-process-list seven">
      {steps.map(([num, title, body, detail]) => (
        <article class="step-popover-card" tabindex="0" aria-describedby={`step-${num}-detail`}>
          <span>{num}</span>
          <h3>{title}</h3>
          <p>{body}</p>
          <div class="step-popover" id={`step-${num}-detail`} role="tooltip">
            <strong>{title} 단계</strong>
            <p>{detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>


  <section class="ty-section">
    <div class="ty-section-head">
      <p class="ty-comment">기업 담당자 확인사항</p>
      <h2>재취업지원서비스 운영체계를 만들기 전에 실무 기준을 정리합니다.</h2>
      <p>기업 담당자가 제도 운영 전에 확인해야 할 실무 항목입니다.</p>
    </div>
    <div class="ty-checks hover-checks">
      {practicalChecks.map(({ title, body, criteria, materials }) => (
        <article class="step-popover-card output-popover-card" tabindex="0" aria-describedby={`practical-${title}-detail`}>
          <strong>{title}</strong>
          <span>{body}</span>
          <div class="step-popover output-popover practical-detail-popover" id={`practical-${title}-detail`} role="tooltip">
            <strong>{title}</strong>
            <p class="popover-section-label">세부 확인 기준</p>
            <ul>
              {criteria.map((item) => <li>{item}</li>)}
            </ul>
            <p class="popover-materials"><strong>준비자료</strong><span>{materials}</span></p>
          </div>
        </article>
      ))}
    </div>
    <aside class="official-manual-card" aria-labelledby="official-manual-title">
      <div class="official-manual-copy">
        <p class="official-manual-label">고용노동부 공식 자료</p>
        <h3 id="official-manual-title">재취업지원서비스 운영 매뉴얼</h3>
        <p>사업주와 인사·노무 담당자가 의무대상자, 서비스 제공 절차와 운영 기준을 확인할 수 있는 사업주용 매뉴얼입니다.</p>
        <small>자료 기준: 고용노동부, 2025. 4. 28. · 실제 적용 시 최신 법령과 사업 안내를 함께 확인해 주세요.</small>
      </div>
      <div class="official-manual-actions" aria-label="고용노동부 재취업지원서비스 운영 매뉴얼 링크">
        <a href="https://www.moel.go.kr/policy/policydata/view.do?bbs_seq=20250401955" target="_blank" rel="noopener noreferrer">고용노동부 안내 페이지</a>
        <a class="secondary" href="https://www.moel.go.kr/common/downloadFile.do?file_seq=20250402902&amp;bbs_seq=20250401955&amp;bbs_id=29&amp;file_ext=pdf" target="_blank" rel="noopener noreferrer">운영 매뉴얼 PDF</a>
      </div>
    </aside>
  </section>

  <section class="ty-section ty-note-panel">
    <div>
      <p class="ty-comment">정리 산출물</p>
      <h2>누구나 일관되게 운영할 수 있는 기준을 마련합니다.</h2>
    </div>
    <div class="ty-checks info-checks hover-checks">
      {outputItems.map(([title, body, detail]) => (
        <article class="step-popover-card output-popover-card" tabindex="0" aria-describedby={`output-${title}-detail`}>
          <strong>{title}</strong>
