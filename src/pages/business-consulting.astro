---
import BaseLayout from '../layouts/BaseLayout.astro';
import { businessConsultingJsonLd } from '../data/structuredData.js';
import RecruitmentStatus from '../components/RecruitmentStatus.astro';
const readinessItems = [
  ['재취업지원서비스 도입 또는 개선을 검토하는 기업', '처음 도입하는 기업은 기본 운영체계를, 이미 운영 중인 기업은 안내·참여·성과관리 방식의 개선점을 중심으로 점검합니다.'],
  ['대상자 규모, 내부 역할, 운영 절차를 정리해야 하는 기업', '퇴직예정자 규모와 발생 시점, 담당 부서 역할, 내부 결재·안내 흐름을 먼저 정리해야 실행 가능한 제도 설계가 가능합니다.'],
  ['담당자 안내, 참여자 모집, 일정 운영 방식을 구체화하려는 기업', '현장 담당자가 바로 설명할 수 있는 안내 문구, 참여자 모집 방식, 회차별 일정 운영 기준을 기업 상황에 맞게 구체화합니다.'],
  ['파일럿 운영을 통해 현장 적용 가능성을 확인하려는 기업', '일부 대상자에게 먼저 적용해 안내문, 상담 흐름, 산출물 정리 방식이 실제 사업장에서 작동하는지 확인합니다.'],
];
const steps = [
  ['01', '착수', '기업 현황과 컨설팅 범위를 확인하고 진행 기준을 맞춥니다.', '담당자, 케이잡스, 컨설턴트가 컨설팅 목적과 범위를 함께 확인합니다. 이후 일정, 자료 준비, 주요 의사결정 지점을 정리해 전체 진행 기준을 맞춥니다.'],
  ['02', '환경분석', '제도 운영 여건, 대상자 규모, 내부 준비 수준을 진단합니다.', '기업의 인력구조, 대상자 발생 가능성, 기존 지원제도, 담당 조직을 확인합니다. 이 단계의 진단 결과가 계획수립과 파일럿 범위를 정하는 기준이 됩니다.'],
  ['03', '계획수립', '기업 상황에 맞는 컨설팅 일정과 운영 방향을 정리합니다.', '방문 일정, 인터뷰·FGI 범위, 참여자 안내 방식, 중간 점검 시점을 정합니다. 기업 여건에 맞는 운영 방향을 문서화해 실행 가능한 계획으로 바꿉니다.'],
  ['04', '중간보고', '진단 결과와 설계 방향을 점검하고 보완 과제를 확인합니다.', '환경분석 결과와 초기 설계안을 공유하고 기업 의견을 반영합니다. 이후 파일럿 운영과 제도설계에서 보완해야 할 쟁점을 확정합니다.'],
  ['05', '파일럿운영', '설계한 서비스 흐름을 일부 대상자에게 시범 적용합니다.', '설계한 서비스 흐름을 일부 대상자에게 적용해 안내문, 상담 절차, 결과 정리 방식의 운영 가능성을 점검합니다.'],
  ['06', '제도설계', '기업이 자체 시행할 수 있는 운영체계와 절차를 구체화합니다.', '담당 부서 역할, 대상자 선정, 프로그램 구성, 기록·성과관리 방식을 정리합니다. 기업이 이후 자체적으로 시행할 수 있는 운영 기준을 남깁니다.'],
  ['07', '최종보고', '자체 시행과 반복 개선을 위한 제도화 기준을 정리합니다.', '진단과 파일럿에서 확인한 내용을 담당자 역할, 운영 절차, 기록·성과관리 기준과 다음 운영주기의 개선과제로 정리합니다. 기업이 이후에도 자체적으로 시행하고 개선할 수 있는 최종 산출물로 마무리합니다.'],
];
const supportTypes = [
  ['기초컨설팅', '시행 경험이 없거나 최근 3년간 실시 경험이 없는 기업의 도입·운영체계 구축을 지원합니다.', '제도를 처음 준비하거나 법령 요건에 적합한 서비스를 제공하지 못한 기업이 대상입니다. 제도 이해, 담당자 역할, 대상자 안내 방식, 기본 운영 흐름을 잡는 데 초점을 둡니다.'],
  ['전문컨설팅', '시행 경험이 있는 기업의 개선사항 진단, 전담인력 역량강화, 운영체계 강화, 성과관리를 점검합니다.', '기존 운영 경험이 있거나 전년도 기초컨설팅에 참여한 기업이 대상입니다. 기존 성과를 계승해 제도 개선, 담당자 역량, 프로그램 품질, 성과관리 기준을 고도화합니다.'],
  ['공동컨설팅', '원·하청 관계사와 중소산업단지 기업이 공동 운영 여건에 맞춰 참여합니다.', '100인 이상 기업이 1개소 이상 참여하면 100인 미만 기업도 함께 신청할 수 있습니다. 현황분석·수요조사, 서비스 제공, 최종 결과보고의 3단계로 조정합니다.'],
];
const practicalChecks = [
  {
    title: '의무기업 여부와 대상자 발생 가능성',
    body: '전년도 고용보험 피보험자 수, 50세 이상 근로자 현황, 퇴직예정자 발생 시점을 먼저 확인합니다.',
    criteria: ['전년도 월평균 고용보험 피보험자 수', '연령대별 근로자 수와 전체 근로자 대비 비율', '해당 연도 퇴직예정자 수와 예상 퇴직 시점', '향후 1~3년간 예상되는 대상자 규모'],
    materials: '고용보험 가입인원 자료, 연령별 인원 현황, 퇴직예정자 인원 집계표',
  },
  {
    title: '담당부서와 내부 의사결정 흐름',
    body: '인사·노무 담당자, 결재선, 노사협의 필요 여부를 정리해 안내와 실행이 끊기지 않게 합니다.',
    criteria: ['제도 운영을 담당할 부서와 실무담당자', '시행계획과 예산을 승인하는 내부 결재선', '참여자 안내와 일정을 조정할 현장 책임자', '노사협의회 또는 노동조합 협의 필요 여부'],
    materials: '조직도, 업무분장표, 내부 결재 절차, 노사협의회 운영 현황',
  },
  {
    title: '서비스 제공 방식과 증빙관리 기준',
    body: '상담·교육·취업알선 등 제공 방식, 참여 안내, 결과물 보관, 만족도 확인 절차를 함께 점검합니다.',
    criteria: ['진로설계·취업알선·취·창업교육·복합제공 중 적합한 유형', '집체교육·개별상담·온라인·대면 등 운영 방식', '참여 대상자 선정과 안내·동의 절차', '상담일지·출석부·교육사진·만족도 조사 등 증빙자료'],
    materials: '기존 교육·상담 자료, 참여자 안내문, 개인정보 동의서, 증빙관리 양식',
  },
  {
    title: '파일럿 운영으로 확인할 현장 쟁점',
    body: '참여자 모집, 일정 운영, 상담 흐름, 결과 정리 방식이 실제 사업장에서 작동하는지 소규모로 확인합니다.',
    criteria: ['파일럿 참여자 모집 가능 여부와 적정 인원', '근무시간·교대근무를 고려한 일정 편성', '상담·교육 장소와 참여시간 확보 가능 여부', '참여자 의견·만족도 확인과 후속 보완 방식'],
    materials: '대상자 후보, 근무일정, 운영장소, 참여 안내계획, 만족도 조사양식',
  },
];
const outputItems = [
  ['운영 현황 진단', '대상자, 준비 수준, 내부 의사결정 필요사항을 구분합니다.', '현재 기업이 바로 실행할 수 있는 부분과 추가 정리가 필요한 부분을 나눠 이후 제도설계의 기준으로 삼습니다.'],
  ['제도화 실행안', '담당자 역할, 운영 절차, 참여자 안내, 파일럿 운영 흐름을 정리합니다.', '담당자가 실제로 사용할 수 있도록 실행 순서, 안내 문구, 일정 운영, 산출물 정리 방식을 포함합니다.'],
  ['최종 개선 과제', '파일럿 결과와 현장 의견을 바탕으로 후속 보완사항을 제시합니다.', '한 번의 컨설팅으로 끝내지 않고 다음 운영 주기에 반영할 개선 과제와 우선순위를 남깁니다.'],
];
---
<BaseLayout title="재취업지원서비스 기업컨설팅" description="기업 현황 진단, 운영체계 설계와 파일럿 검증을 거쳐 재취업지원서비스를 자체 시행하고 개선할 수 있는 제도화 기반 마련을 지원합니다." jsonLd={businessConsultingJsonLd}>
  <section class="ty-hero sub">
    <div class="ty-mark">기업컨설팅</div>
    <p class="ty-comment">기업의 자체 시행과 반복 개선 지원</p>
    <h1 class="business-title">재취업지원서비스 기업컨설팅으로<br />기업이 자체 시행하고 개선할 수 있는 제도화 기반을 마련합니다.</h1>
    <p class="ty-lead">기업의 현황과 기존 시행 경험을 진단하고, 운영체계 설계와 파일럿 검증을 거쳐<br class="wide-break" /> 재취업지원서비스를 지속적으로 시행·개선할 수 있는 기반을 마련합니다.</p>
    <div class="mobile-quick-card service" aria-label="기업컨설팅 모바일 핵심 안내">
      <span>기업 담당자 확인사항</span>
      <strong>제도 운영 전에 다음 항목을 확인하세요.</strong>
      <ul>
        <li>의무기업 여부와 대상자 발생 가능성 확인</li>
        <li>담당부서·내부 결재 흐름 정리</li>
        <li>파일럿 운영으로 현장 적용성 점검</li>
      </ul>
      <a href="/contact/">기업컨설팅 문의하기</a>
    </div>
  </section>

  <section class="ty-section page-next-actions business-guide-entry" aria-labelledby="business-guide-entry-title">
    <div class="ty-note-panel">
      <div>
        <p class="ty-comment">기업 담당자 빠른 안내</p>
        <h2 id="business-guide-entry-title">재취업지원서비스 기업컨설팅을 처음 검토하나요?</h2>
        <p>지원대상, 기초·전문·공동컨설팅의 차이, 7단계 진행절차와 기업 준비자료를 한 페이지에서 확인할 수 있습니다.</p>
      </div>
      <div class="page-next-actions-grid" aria-label="기업컨설팅 상세 안내">
        <a class="primary" href="/business-consulting-guide/">
          <strong>기업컨설팅 종합 안내</strong>
          <span>대상·유형·절차·준비자료 확인</span>
        </a>
        <a href="/faq/#consulting-faq-title">
          <strong>기업컨설팅 FAQ</strong>
          <span>비용·기간·신청 전 질문 확인</span>
        </a>
        <a href="/contact/#consultation-request">
          <strong>신청 전 상담</strong>
          <span>기업 상황과 준비자료 확인</span>
        </a>
      </div>
    </div>
  </section>

  <section class="ty-section recruitment-notice" aria-labelledby="recruitment-title">
    <div class="ty-section-head">
      <p class="ty-comment">2026년 기업컨설팅 모집 안내</p>
      <h2 id="recruitment-title">5차·6차 기업컨설팅 신청기간을 확인하세요.</h2>
      <p>6차도 일반 기업이 신청할 수 있으며, 500~999인 기업의 전문컨설팅 추가 참여와 제도 장기 미도입 기업의 기초컨설팅 재참여가 한시적으로 허용됩니다.</p>
    </div>

    <div class="recruitment-rounds">
      <article class="recruitment-round closed" aria-labelledby="round-five-title">
        <RecruitmentStatus start="2026-07-27" end="2026-08-31" />
        <h3 id="round-five-title">2026년 5차 기업컨설팅</h3>
        <p class="round-intro">재취업지원서비스 도입 또는 개선이 필요한 기업을 대상으로 기업컨설팅을 지원합니다.</p>
        <div class="round-facts" aria-label="기업컨설팅 5차 모집 핵심 일정">
          <p><strong>신청기간</strong><span>2026. 7. 27.~8. 31.</span></p>
          <p><strong>지원대상</strong><span>100~999인 기업 우선</span><small>1,000인 이상 의무대상기업 신청 가능</small></p>
          <p><strong>컨설팅 비용</strong><span>전액 무료</span></p>
        </div>
        <p class="round-period">컨설팅 기간: 2026. 9. 7.~11. 27.</p>
      </article>

      <article class="recruitment-round upcoming" aria-labelledby="round-six-title">
        <RecruitmentStatus start="2026-09-01" end="2026-09-22" />
        <h3 id="round-six-title">2026년 6차 기업컨설팅</h3>
        <p class="round-intro">재취업지원서비스 도입·개선을 희망하는 기업의 일반 신청과 최신 공고의 재참여 요건에 해당하는 기업의 신청을 함께 받습니다.</p>
        <div class="round-facts" aria-label="기업컨설팅 6차 모집 핵심 일정">
          <p><strong>신청기간</strong><span>2026. 9. 1.~9. 22.</span></p>
          <p><strong>지원대상</strong><span>의무대상기업 및 제도 도입·개선 희망기업</span><small>전문·기초 재참여 특례는 아래 요건 확인</small></p>
          <p><strong>컨설팅 비용</strong><span>전액 무료</span></p>
        </div>
        <p class="round-period">선정심사: 9. 28. · 선정발표: 9. 29. · 컨설팅 기간: 9. 30.~11. 27.</p>
      </article>
    </div>

    <details class="recruitment-details">
      <summary>6차 신청대상과 재참여 특례 확인</summary>
      <div class="recruitment-detail-grid">
        <div>
          <h3>일반 신청대상</h3>
          <p>6차도 재취업지원서비스 의무대상기업과 제도 도입·개선을 희망하는 기업이 신청할 수 있습니다. 재참여 특례 대상에 해당하지 않더라도 일반 신청 자격과 참여 제한을 충족하면 신청할 수 있습니다.</p>
        </div>
        <div>
          <h3>전문컨설팅 재참여 특례</h3>
          <p>500~999인 기업 중 2021~2025년에 기초·전문컨설팅에 모두 참여한 기업은 전문컨설팅 추가 참여를 신청할 수 있습니다.</p>
          <h3>기초컨설팅 재참여 특례</h3>
          <p>제도 장기 미도입 기업 중 2021년 기초·2022년 전문컨설팅 참여 후 3년이 경과한 기업은 기초컨설팅 추가 참여를 신청할 수 있습니다. 두 특례는 요건과 신청 유형이 다르므로 해당 차수 공고를 기준으로 확인합니다.</p>
        </div>
        <div>
          <h3>신청 제한</h3>
          <p>국가·지방행정기관, 최근 3년간 체불사업주 명단 공개 사업장, 중대산업재해 또는 산업재해 발생건수 등 공표기업은 신청할 수 없습니다.</p>
        </div>
      </div>
    </details>
    <div class="recruitment-actions">
      <a href="https://www.nosa.or.kr/portal/nosa/majorBiz/reEmpymnSport/entrprsCnsl" target="_blank" rel="noopener noreferrer">노사발전재단 공식 신청 안내</a>
      <a class="primary" href="/contact/">케이잡스 신청 전 상담</a>
    </div>
    <p class="recruitment-source">근거: 노사발전재단 <a href="https://www.nosa.or.kr/board/bltnMngr?boardId=nosa05&amp;bltnNo=11785485331738&amp;" target="_blank" rel="noopener noreferrer">5차 변경공고(2026. 7. 31.)</a> · <a href="https://www.nosa.or.kr/board/bltnMngr?boardId=nosa05&amp;bltnNo=11788226445943&amp;" target="_blank" rel="noopener noreferrer">6차 모집공고·재참여 요건(2026. 9. 1.)</a><br />확인 기준: 2026. 9. 7. · 접수 상태는 기재된 신청기간 기준이며, 일정 변경·추가 안내는 최신 공식 공고를 확인해 주세요.</p>
  </section>

  <section class="ty-section">
    <div class="ty-section-head">
      <h2>기업의 제도화 준비를 확인합니다.</h2>
      <p>의무대상기업과 제도 도입·개선을 검토하는 기업의 운영 여건을 점검합니다. 재취업지원서비스 제공 의무 여부와 기업컨설팅 지원사업 신청자격은 구분해서 확인해야 합니다. 신청자격과 참여 제한은 <a href="#recruitment-title">해당 차수 모집 안내</a>와 공식 공고를, 제도 변화의 시행 단계는 <a href="/policy-updates/">정책·제도 업데이트</a>를 참고해 주세요.</p>
    </div>
    <div class="ty-list-grid info-grid hover-info-grid">
      {readinessItems.map(([title, detail]) => (
        <article class="step-popover-card readiness-popover-card" tabindex="0" aria-describedby={`readiness-${title}-detail`}>
          <strong>{title}</strong>
          <div class="step-popover readiness-popover" id={`readiness-${title}-detail`} role="tooltip">
            <strong>{title}</strong>
            <p>{detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ty-section" id="business-consulting-process">
    <div class="ty-section-head">
      <h2>K·JOBS가 안내하는 7단계로 제도화 가능성을 확인합니다.</h2>
      <p>아래 7단계는 기업 현황 진단, 운영체계 설계와 파일럿 검증을 거쳐 자체 시행과 반복 개선이 가능한 제도화 기반으로 연결하는 K·JOBS의 단일기업 컨설팅 안내 흐름입니다. 실제 일정과 세부 범위는 노사발전재단의 해당 연도 사업 안내와 기업별 협의를 기준으로 확정합니다.</p>
    </div>
    <div class="ty-process-list seven">
      {steps.map(([num, title, body, detail]) => (
        <article class="step-popover-card" tabindex="0" aria-describedby={`step-${num}-detail`}>
          <span>{num}</span>
          <h3>{title}</h3>
          <p>{body}</p>
          <div class="step-popover" id={`step-${num}-detail`} role="tooltip">
            <strong>{title} 단계</strong>
            <p>{detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-section-head">
      <h2>기업 상황에 따라 컨설팅 유형이 달라집니다.</h2>
      <p>기초·전문·공동컨설팅은 기업의 시행 경험과 운영 여건에 따라 다르게 적용됩니다.</p>
    </div>
    <div class="ty-feature-row three info-grid">
      {supportTypes.map(([title, body, detail]) => (
        <article class="step-popover-card support-popover-card" tabindex="0" aria-describedby={`support-${title}-detail`}>
          <h3>{title}</h3>
          <p>{body}</p>
          <div class="step-popover support-popover" id={`support-${title}-detail`} role="tooltip">
            <strong>{title}</strong>
            <p>{detail}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="ty-section">
    <div class="ty-section-head">
      <p class="ty-comment">기업 담당자 확인사항</p>
      <h2>재취업지원서비스 운영체계를 만들기 전에 실무 기준을 정리합니다.</h2>
      <p>기업 담당자는 현황자료 확인, 내부 협의와 일정 조정, 참여자 안내, 설계안 검토에 함께 참여합니다. 컨설턴트와 역할을 나누고 기업의 의사결정이 필요한 사항을 확인해 실행 가능한 운영 기준으로 정리합니다. 아래 항목에서 준비자료와 실무 기준을 확인하세요.</p>
    </div>
    <div class="ty-checks hover-checks">
      {practicalChecks.map(({ title, body, criteria, materials }) => (
        <article class="step-popover-card output-popover-card" tabindex="0" aria-describedby={`practical-${title}-detail`}>
          <strong>{title}</strong>
          <span>{body}</span>
          <div class="step-popover output-popover practical-detail-popover" id={`practical-${title}-detail`} role="tooltip">
            <strong>{title}</strong>
            <p class="popover-section-label">세부 확인 기준</p>
            <ul>
              {criteria.map((item) => <li>{item}</li>)}
            </ul>
            <p class="popover-materials"><strong>준비자료</strong><span>{materials}</span></p>
          </div>
        </article>
      ))}
    </div>
    <aside class="official-manual-card" aria-labelledby="official-manual-title">
      <div class="official-manual-copy">
        <p class="official-manual-label">고용노동부 공식 자료</p>
        <h3 id="official-manual-title">재취업지원서비스 운영 매뉴얼</h3>
        <p>사업주와 인사·노무 담당자가 의무대상자, 서비스 제공 절차와 운영 기준을 확인할 수 있는 사업주용 매뉴얼입니다.</p>
        <small>자료 기준: 고용노동부, 2025. 4. 28. · 실제 적용 시 최신 법령과 사업 안내를 함께 확인해 주세요.</small>
      </div>
      <div class="official-manual-actions" aria-label="고용노동부 재취업지원서비스 운영 매뉴얼 링크">
        <a href="https://www.moel.go.kr/policy/policydata/view.do?bbs_seq=20250401955" target="_blank" rel="noopener noreferrer">고용노동부 안내 페이지</a>
        <a class="secondary" href="https://www.moel.go.kr/common/downloadFile.do?file_seq=20250402902&amp;bbs_seq=20250401955&amp;bbs_id=29&amp;file_ext=pdf" target="_blank" rel="noopener noreferrer">운영 매뉴얼 PDF</a>
      </div>
    </aside>
  </section>

  <section class="ty-section ty-note-panel">
    <div>
