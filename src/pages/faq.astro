---
import BaseLayout from '../layouts/BaseLayout.astro';
import { careerPlanningEligibilityAnswer, serviceCostAnswer } from '../data/serviceFacts.js';

const consultingFaqs = [
  {
    q: '어떤 기업이 기업컨설팅을 검토할 수 있나요?',
    a: '제도 도입을 준비하거나 기존 운영체계를 개선하려는 기업이 상담을 요청할 수 있습니다.',
    detail: '의무대상기업뿐 아니라 원·하청 또는 산업단지 단위 공동 운영을 검토하는 기업도 상담할 수 있습니다. 서비스 제공 의무 여부와 지원사업 신청자격은 별개이며, 상담 요청이 사업 선정을 뜻하지는 않습니다. 신청자격과 참여 제한은 해당 차수의 공식 모집공고로 확인해야 합니다.',
  },
  {
    q: '재취업지원서비스 기업컨설팅은 무료인가요?',
    a: '노사발전재단 재취업지원서비스 시행지원 사업으로 선정된 기업의 기업컨설팅 비용은 전액 무료입니다.',
    detail: '상담 단계에서는 신청 가능 여부와 모집 일정을 먼저 확인합니다. 무료 지원은 사업 선정을 전제로 하므로, 해당 차수의 공식 공고와 선정 안내를 확인해 주세요.',
  },
  {
    q: '재취업지원서비스 기업컨설팅은 얼마나 걸리나요?',
    a: '진행기간은 모집 차수의 사업 일정과 기업별 컨설팅 범위에 따라 달라집니다.',
    detail: 'K·JOBS는 현황 진단, 계획수립, 중간점검, 파일럿 운영, 제도설계와 결과 정리의 흐름으로 안내합니다. 기업의 내부 보고·협의 일정과 참여자 운영 여건을 함께 검토하며, 실제 일정은 선정 이후 기업과 협의해 확정합니다.',
  },
  {
    q: '퇴직예정자가 아직 없어도 기업컨설팅을 검토할 수 있나요?',
    a: '제도 도입이나 운영체계 사전 준비가 필요하다면 상담을 통해 가능성을 확인할 수 있습니다.',
    detail: '예상되는 대상자 발생 시점, 담당 부서와 안내 절차를 미리 정리하면 준비할 과제를 구분하기 쉽습니다. 다만 퇴직예정자가 없다는 사실만으로 신청 가능 여부나 선정 여부가 결정되지는 않으며, 해당 차수의 사업 기준을 확인해야 합니다.',
  },
  {
    q: '재취업지원서비스 기업컨설팅은 무엇을 지원하나요?',
    a: '기업 현황 진단, 운영체계 설계와 파일럿 검증을 통해 자체 시행과 반복 개선에 활용할 제도화 기반 마련을 지원합니다.',
    detail: '담당자 역할, 대상자 안내, 서비스 운영, 기록·성과관리 기준을 기업 여건에 맞게 설계합니다. 설계안을 현장에 적용해 보완점을 확인하고 이후 운영에 활용할 기준으로 정리하는 과정이며, 컨설팅을 받는 것만으로 제도화가 완료되는 것은 아닙니다.',
  },
  {
    q: '기초컨설팅과 전문컨설팅은 어떻게 다른가요?',
    a: '기초컨설팅은 기본 운영체계 구축에, 전문컨설팅은 기존 운영 경험을 바탕으로 한 개선에 초점을 둡니다.',
    detail: '처음 도입하는 기업은 현황 진단부터 운영체계 설계와 파일럿 점검으로 이어집니다. 전문컨설팅에서는 기존 진단자료·설계안·파일럿 결과 중 활용할 부분을 먼저 확인하고, 미해결 과제와 달라진 여건을 중심으로 담당자 역량과 성과관리 기준을 보완합니다. 적용 유형과 범위는 사업 기준과 기업 상황을 확인해 정합니다.',
  },
  {
    q: '이미 재취업지원서비스를 운영 중인 기업도 컨설팅이 필요한가요?',
    a: '기존 운영에서 개선할 과제가 있다면 컨설팅을 검토할 수 있습니다.',
    detail: '참여율이 낮은 이유, 안내가 늦어지는 지점, 담당자 역할과 결과물 관리 방식 등을 살펴봅니다. 잘 작동하는 절차는 유지하고 보완할 부분을 정리하므로, 기존 체계를 모두 새로 만드는 방식으로만 접근하지 않습니다. 지원 가능 여부는 해당 차수의 공고를 별도로 확인해야 합니다.',
  },
  {
    q: '공동컨설팅은 단일기업 컨설팅과 무엇이 다른가요?',
    a: '공동컨설팅은 공통 여건을 가진 여러 기업이 함께 운영모델을 설계하는 방식입니다.',
    detail: '업종·지역·원하청 관계 등을 바탕으로 공동 과제를 찾되, 기업별 대상자와 운영 여건의 차이도 확인합니다. 대표사와 참여사의 자료 확인, 일정 조정, 참여자 안내 역할을 구분하고 현황분석·수요조사, 서비스 제공과 최종 결과보고를 공동으로 추진합니다.',
  },
  {
    q: '기업컨설팅 신청 전에 무엇을 준비해야 하나요?',
    a: '대상자 발생 가능성, 기존 운영 여부, 담당 부서와 내부 의사결정 일정을 먼저 확인해 주세요.',
    detail: '상담에는 대상자 예상 규모와 발생 시점, 기존 교육·전직지원 프로그램, 내부 보고 일정, 노사협의 또는 인사부서 협의 필요성, 희망 진행 시기를 정리하면 도움이 됩니다. 이는 상담 준비사항이며 공식 신청서류 목록과는 다릅니다. 최초 문의에는 개인별 명단이나 내부 인사자료 대신 현황을 요약해 남기고, 제출서류는 모집공고와 담당자 안내에 따라 확인해 주세요.',
  },
  {
    q: '재취업지원서비스 의무기업은 무엇을 먼저 확인해야 하나요?',
    a: '대상자 발생 가능성, 안내 시점, 서비스 제공 방식과 증빙관리 기준을 먼저 점검해야 합니다.',
    detail: '누가 대상 여부를 확인하고 안내하는지, 서비스 운영과 기록을 어느 부서가 맡는지 함께 정리합니다. 기업컨설팅은 이 운영체계를 점검·설계하는 지원이며, 컨설팅 참여 자체를 법정 서비스 제공 의무의 이행과 동일하게 볼 수는 없습니다. 구체적인 의무 적용은 최신 법령과 공식 안내로 확인해야 합니다.',
  },
  {
    q: '재취업지원서비스를 처음 도입하는 기업은 어디서부터 준비해야 하나요?',
    a: '담당 부서를 정하고 대상자 확인부터 안내·서비스 운영까지의 기본 흐름을 그려보는 것부터 시작하면 좋습니다.',
    detail: '현재 활용할 수 있는 교육·상담 자원과 내부 안내 절차를 확인한 뒤 빠진 부분을 진단합니다. 컨설턴트와 운영체계를 설계하고 파일럿으로 현장 적용성을 점검하며, 담당자가 이후 운영할 수 있도록 역할·절차·기록 기준을 정리합니다.',
  },
  {
    q: '상담신청 후에는 어떻게 진행되나요?',
    a: '담당자가 기업의 문의 내용과 사업 기준을 확인한 뒤 신청 절차와 진행 가능 여부를 안내합니다.',
    detail: '제도 도입 또는 개선 목적, 현재 운영 경험, 희망 일정과 준비자료를 확인합니다. 상담과 공식 신청·선정은 구분되며, 상담만으로 참여가 확정되지는 않습니다. 선정 이후에는 기업과 컨설팅 범위, 협의 일정과 역할을 구체화합니다.',
  },
  {
    q: '인사담당자가 재취업지원서비스 운영체계를 만들 때 중요한 것은 무엇인가요?',
    a: '기업 내부에서 결정·조정할 일과 컨설턴트가 지원할 일을 나누는 것이 중요합니다.',
    detail: '기업 담당자는 현황자료 확인, 내부 보고·협의, 일정 조정, 참여자 안내와 설계안 검토를 맡습니다. 컨설턴트는 진단과 수요 확인, 운영체계 설계, 파일럿 점검과 개선과제 정리를 지원합니다. 기업의 실행 여건을 함께 확인하면서 담당 부서, 안내 절차, 결과물 보관과 후속 점검 기준을 정리합니다.',
  },
  {
    q: '파일럿 운영은 왜 필요한가요?',
    a: '설계한 운영체계가 실제 사업장에서 작동하는지 확인하고 보완하기 위한 단계입니다.',
    detail: '안내문을 이해하기 쉬운지, 참여자가 일정에 참여할 수 있는지, 상담 흐름과 결과물 정리 방식이 적절한지 점검합니다. 기업 담당자는 일정·참여자 안내를 조정하고 컨설턴트는 적용 과정과 보완점을 확인합니다. 파일럿의 범위와 방식은 기업 여건에 맞춰 협의하며, 파일럿만으로 모든 서비스 운영이 완료되는 것은 아닙니다.',
  },
  {
    q: '파일럿 운영 결과는 최종 제도설계에 어떻게 반영되나요?',
    a: '현장의견을 확인하고 기업과 보완 방향을 협의한 뒤 운영기준과 개선과제에 반영합니다.',
    detail: '참여자 반응, 담당자 의견, 안내문 이해도, 상담 흐름, 결과물 작성과 일정 운영의 어려움을 살펴봅니다. 확인된 의견을 모두 그대로 적용하는 것이 아니라 필요성과 실행 가능성을 협의하고, 안내·역할·절차 등 수정할 항목과 추후 점검할 항목을 구분해 정리합니다.',
  },
  {
    q: '기업컨설팅 결과물은 무엇이며 내부 보고에 어떻게 활용하나요?',
    a: '기업 현황 진단, 운영체계 설계안, 파일럿 결과와 개선과제를 내부 보고와 다음 운영계획에 활용할 수 있도록 정리합니다.',
    detail: '담당자 역할, 참여자 안내 방식, 운영 절차, 기록·성과관리 기준과 후속 실행 방향을 기업별 상황에 맞게 정리합니다. 내부 보고에서는 확인된 현황과 개선 필요사항, 협의한 실행과제를 구분하고, 이후 자체 시행에 필요한 역할과 일정을 검토하는 자료로 활용할 수 있습니다. 다른 기업 사례는 참고자료이며 같은 결과나 지원을 보장하지 않습니다.',
    link: { href: '/business-consulting/#official-casebooks', label: '노사발전재단 공식 우수사례집 확인' },
  },
];

// One answer source for visible paragraphs and FAQPage, including link text.
const answerText = (item) => [item.a, item.detail, item.link?.label, item.source?.label].filter(Boolean).join(' ');

const careerFaqs = [
  {
    q: '커리어플래닝서비스는 어떤 서비스인가요?',
    a: '중장년 재직자의 직무경험, 보유역량, 관심 분야, 향후 경력방향을 점검하고 경력설계와 실행계획을 상담 중심으로 정리하는 서비스입니다.',
  },
  {
    q: '커리어플래닝서비스에서는 어떤 도움을 받을 수 있나요?',
    a: '경력진단과 경력설계를 통해 직무전환, 계속근로 또는 구직 준비 방향을 정리합니다.',
  },
  {
    q: '커리어플래닝서비스는 누가 신청할 수 있나요?',
    a: careerPlanningEligibilityAnswer,
  },
  {
    q: '퇴직예정자가 아니어도 신청할 수 있나요?',
    a: '커리어플래닝서비스는 재직 중 경력설계 성격이 있으므로 퇴직예정자 여부만으로 판단하지 않습니다. 재직 여부, 연령, 사업 기준, 운영 가능 일정 등을 함께 확인합니다.',
  },
  {
    q: '개인도 커리어플래닝서비스를 신청할 수 있나요?',
    a: '개인 신청자는 커리어플래닝서비스 페이지에서 신청서와 개인정보 동의서를 내려받아 작성·서명한 뒤 재직 증빙서류와 함께 이메일로 제출할 수 있습니다. 접수 후 사업 기준에 따른 대상 여부와 상담 일정을 안내합니다.',
  },
  {
    q: '기업 단위로도 커리어플래닝서비스를 운영할 수 있나요?',
    a: '기업 단위 운영도 문의할 수 있습니다. 문의 페이지에서 참여 예상 인원과 희망 일정을 남기면 사업 기준에 따른 대상 조건과 운영 가능 일정을 확인해 안내합니다.',
  },
  {
    q: '상담에서는 어떤 내용을 다루나요?',
    a: '현재까지의 직무경험, 강점, 관심 분야, 역할 변화 가능성, 직무전환 또는 계속근로 방향, 교육·자격·구직 준비 등 후속 실행과제를 다룹니다.',
  },
  {
    q: '상담에서는 어떤 경력 방향을 다루나요?',
    a: '계속근로, 직무전환, 역량개발, 전직 준비 등 개인 상황에 맞는 방향을 함께 정리합니다.',
  },
  {
    q: '상담 결과는 어떤 형태로 정리되나요?',
    a: '상담 결과는 참여자의 경력 흐름, 보유역량, 향후 목표, 실행 과제와 후속 준비사항을 중심으로 정리됩니다. 일과 직무, 앞으로의 경력 방향에 초점을 둡니다.',
  },
  {
    q: '경력설계서에는 어떤 내용이 들어가나요?',
    a: '직무경험, 주요 강점, 보유역량, 관심 분야, 향후 경력방향, 역량 보완 과제, 실행계획, 후속 준비사항 등이 개인별 상담 결과에 맞게 정리됩니다.',
  },
  {
    q: '상담 결과는 회사에 공유되나요?',
    a: '개인정보와 상담 세부내용은 목적 범위 안에서 관리되어야 합니다. 기업 단위 운영의 경우에도 공유 범위와 방식은 사전 안내와 동의 기준에 따라 구분하는 것이 원칙입니다.',
  },
  {
    q: '신청 전에 어떤 정보를 확인하면 좋나요?',
    a: '개인 신청자는 신청서와 개인정보 동의서를 작성·서명하고, 재직증명서 또는 4대 사회보험 가입자 가입내역 확인서 중 1부를 준비합니다. 작성한 서류는 커리어플래닝서비스 페이지에 안내된 이메일로 제출합니다.',
  },
  {
    q: '주민등록번호나 민감정보를 입력해야 하나요?',
    a: '상담신청에는 주민등록번호, 건강정보, 급여자료, 내부 인사자료 등 민감정보를 입력하지 마세요. 상담과 연락에 필요한 최소 정보만 남겨 주세요.',
  },
  {
    q: '40대와 50대 재직자도 경력설계 상담을 받을 수 있나요?',
    a: '사업 기준과 운영 상황에 따라 중장년 재직자는 경력진단과 경력설계 상담을 검토할 수 있습니다. 상담에서는 직무경험, 보유역량, 직무전환 가능성, 계속근로 방향, 재취업 준비사항을 확인합니다.',
  },
  {
    q: '퇴직 전 경력설계 상담에서는 무엇을 정리하나요?',
    a: '퇴직 전 경력설계 상담에서는 현재 직무경험, 강점, 보유자격, 희망 근무조건, 직무전환 가능성, 재취업 준비 정도, 향후 실행계획을 일·직무 중심으로 정리합니다.',
  },
  {
    q: '중장년 재직자가 직무전환을 준비할 때 어떤 도움이 되나요?',
    a: '기존 업무경험을 다른 기업과 직무에서도 쉽게 이해할 수 있도록 정리하고, 필요한 교육·자격과 구직정보를 찾는 방법을 확인할 수 있습니다.',
  },
];

const commonFaqs = [
  {
    q: '경력지원서비스란 무엇인가요?',
    a: '경력지원서비스는 재직자의 경력진단과 경력설계부터 퇴직예정자의 경력전환과 재취업 준비까지 연결하여 살펴보는 지원 개념입니다.',
    detail: '고용노동부는 2026년 5월 14일 경력관리·역량 향상의 의미를 담아 재취업지원서비스를 가칭 경력지원서비스로 변경하는 방안을 발표했습니다. 명칭 변경 추진과 실제 시행은 구분하고, 신청은 해당 사업의 공식 안내를 기준으로 확인해야 합니다.',
    link: { href: '/career-support/', label: '경력지원서비스 대상·비용·신청 안내' },
    source: { href: 'https://www.moel.go.kr/news/enews/report/enewsView.do?news_seq=19387', label: '고용노동부 2026년 5월 14일 발표 원문' },
  },
  {
    q: '경력지원서비스는 재취업지원서비스와 다른 정부사업인가요?',
    a: '명칭 변경 추진이 별도 정부사업의 신설이나 지원대상·사업 선정의 자동 확대를 뜻하지는 않습니다.',
    detail: '현재 신청자격과 지원범위는 재취업지원서비스 시행지원의 해당 차수 공식 모집공고를 기준으로 확인해야 합니다. 상담신청과 공식 신청·선정도 구분되므로, 참여 가능 여부는 사업 기준과 담당자 안내를 함께 확인해 주세요.',
  },
  {
    q: '2027년 경력지원서비스로 명칭이 바뀌나요?',
    a: '정부가 명칭 변경을 추진하고 있지만, 2027년부터 확정 시행된다고 안내할 단계는 아닙니다.',
    detail: '고용노동부가 2026년 5월 14일 발표한 방안은 가칭 경력지원서비스로의 명칭 변경과 2027년 상반기까지 고령자고용법 개정을 추진하는 목표를 제시했습니다. 이는 시행일 확정과 다르며, 확정 명칭과 시행일은 후속 법령을 확인해야 합니다.',
    link: { href: '/policy-updates/reemployment-service-reform-2026/', label: '재취업지원서비스 제도개편 방안 살펴보기' },
    source: { href: 'https://www.moel.go.kr/news/enews/report/enewsView.do?news_seq=19387', label: '고용노동부 2026년 5월 14일 발표 원문' },
  },
  {
    q: '상담신청을 하면 언제 연락을 받을 수 있나요?',
    a: '담당자가 상담 유형, 연락처와 문의 내용을 확인하는 대로 연락드립니다.',
  },
  {
    q: '상담신청 후 최종 진행 여부는 언제 안내되나요?',
    a: '담당자가 대상 여부, 일정, 준비자료와 사업 기준을 확인한 뒤 최종 진행 여부를 안내합니다.',
  },
  {
    q: '상담신청에 어떤 정보를 남기면 되나요?',
    a: '성명 또는 담당자명, 기업명, 연락처, 이메일, 상담 유형, 희망 내용을 중심으로 남기면 됩니다. 상담 단계에서는 필요한 최소 정보만 입력하는 것이 원칙입니다.',
  },
  {
    q: '민감정보를 입력하면 어떻게 해야 하나요?',
    a: '주민등록번호, 건강정보, 급여자료, 내부 인사자료, 퇴직자 명단 등은 입력하지 않아야 합니다. 이미 입력한 경우에는 담당자 안내에 따라 필요한 범위에서 정정 또는 삭제 요청을 할 수 있습니다.',
  },
  {
    q: '비용이 발생하나요?',
    a: serviceCostAnswer,
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...consultingFaqs, ...careerFaqs, ...commonFaqs].map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answerText(item),
    },
  })),
};
---
<BaseLayout title="재취업지원서비스와 경력지원서비스 자주 묻는 질문" description="재취업지원서비스 기업컨설팅의 준비·진행, 커리어플래닝서비스 신청, 가칭 경력지원서비스로의 명칭 변경 추진에 관한 질문과 답변을 확인하세요." jsonLd={faqJsonLd}>
  <section class="ty-hero sub">
    <div class="ty-mark">FAQ</div>
    <p class="ty-comment">경력지원서비스 · 기업컨설팅 · 커리어플래닝서비스</p>
    <h1>재취업지원서비스와<br />경력지원서비스 FAQ</h1>
    <p class="ty-lead">기업 담당자와 개인 신청자가 가장 먼저 확인하는 질문을 나누어 정리했습니다. 상담 전 대상 여부, 준비자료, 진행 방식을 빠르게 확인할 수 있습니다.</p>
  </section>

  <nav class="faq-discovery" aria-label="FAQ 질문 찾기">
    <div class="faq-search-panel">
      <label for="faq-search">질문 검색</label>
      <div class="faq-search-row">
        <input id="faq-search" type="search" placeholder="예: 신청방법, 비용, 준비서류" autocomplete="off" />
        <button id="faq-search-clear" type="button">검색 지우기</button>
      </div>
      <p id="faq-search-status" aria-live="polite">전체 {consultingFaqs.length + careerFaqs.length + commonFaqs.length}개 질문을 확인할 수 있습니다.</p>
    </div>
    <div class="faq-category-links" aria-label="FAQ 카테고리 바로가기">
      <a href="#consulting-faq-title"><strong>기업컨설팅</strong><span>{consultingFaqs.length}개 질문</span></a>
      <a href="#career-faq-title"><strong>커리어플래닝</strong><span>16개 질문</span></a>
      <a href="#common-faq-title"><strong>신청·비용·개인정보</strong><span>8개 질문</span></a>
    </div>
  </nav>

  <section class="ty-section faq-section" data-faq-section aria-labelledby="consulting-faq-title">
    <div class="ty-section-head">
      <p class="ty-comment">기업 담당자용</p>
      <h2 id="consulting-faq-title">기업컨설팅 FAQ</h2>
      <p>재취업지원서비스를 기업 안에서 제도화하고 운영체계를 준비할 때 자주 묻는 질문입니다. 신청자격은 <a href="/business-consulting/#recruitment-title">기업컨설팅 모집 안내</a>에서, 제도 변화와 시행 단계는 <a href="/policy-updates/">정책·제도 업데이트</a>에서 확인하세요.</p>
    </div>
    <div class="faq-list">
      {consultingFaqs.map((item) => (
        <details class="faq-item consulting-faq-item" data-faq-item>
          <summary>{item.q}</summary>
          <div class="consulting-faq-answer">
            <p class="direct-answer">{item.a}</p>
            <p>{item.detail}</p>
            {item.link && <p><a href={item.link.href}>{item.link.label}</a></p>}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="ty-section faq-section" data-faq-section aria-labelledby="career-faq-title">
    <div class="ty-section-head">
      <p class="ty-comment">개인·기업 신청 공통</p>
      <h2 id="career-faq-title">커리어플래닝서비스 FAQ</h2>
      <p>중장년 재직자의 경력진단과 경력설계 상담을 검토할 때 자주 묻는 질문입니다.</p>
      <p><a href="https://www.nosa.or.kr/board/bltnMngr?boardId=nosa202109&amp;bltnNo=11780540696956&amp;" target="_blank" rel="noopener noreferrer">노사발전재단 2026년 공식 서비스 안내</a> · <a href="/career-planning/#career-application-title">참여조건·신청서류 확인</a></p>
    </div>
    <div class="faq-list">
      {careerFaqs.map((item) => (
        <details class="faq-item" data-faq-item>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="ty-section faq-section" data-faq-section aria-labelledby="common-faq-title">
    <div class="ty-section-head">
      <p class="ty-comment">상담신청 공통 확인</p>
      <h2 id="common-faq-title">공통 FAQ</h2>
      <p>경력지원서비스 명칭, 상담신청, 개인정보 입력, 연락 방식 등 공통으로 확인할 질문입니다.</p>
    </div>
    <div class="faq-list">
      {commonFaqs.map((item) => (
        <details class="faq-item common-faq-item" data-faq-item>
          <summary>{item.q}</summary>
          {item.detail ? <div class="consulting-faq-answer">
            <p class="direct-answer">{item.a}</p>
            <p>{item.detail}</p>
            {item.link && <p><a href={item.link.href}>{item.link.label}</a></p>}
            {item.source && <p><a href={item.source.href}>{item.source.label}</a></p>}
          </div> : <p>{item.a}</p>}
        </details>
      ))}
    </div>
  </section>

  <section class="faq-empty" id="faq-empty" hidden aria-live="polite">
    <h2>검색 결과가 없습니다.</h2>
    <p>다른 검색어를 입력하거나 상담신청으로 확인해 주세요.</p>
    <a href="/contact/#consultation-request">상담신청으로 확인</a>
  </section>

  <section class="ty-section faq-note" aria-label="상담 전 확인">
    <div class="ty-note-panel">
      <h2>원하는 답을 찾지 못했다면 상담신청으로 확인하세요.</h2>
      <p>궁금한 내용을 남겨 주시면 대상 여부와 신청 절차를 안내해 드립니다. 주민등록번호 등 민감정보는 입력하지 마세요.</p>
      <div class="faq-actions" aria-label="서비스별 다음 단계">
        <a href="/contact/#consultation-request">기업컨설팅 상담신청</a>
        <a class="primary" href="/career-planning/#career-application-title">커리어플래닝 개인 신청</a>
        <a href="/contact/#consultation-request">커리어플래닝 기업 운영 문의</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.querySelector('#faq-search');
      const clear = document.querySelector('#faq-search-clear');
      const status = document.querySelector('#faq-search-status');
      const empty = document.querySelector('#faq-empty');
      const items = [...document.querySelectorAll('[data-faq-item]')];
      const sections = [...document.querySelectorAll('[data-faq-section]')];
      if (!input || !clear || !status || !empty) return;
      const normalize = (value) => value.toLocaleLowerCase('ko-KR').replace(/\s+/g, ' ').trim();
      const filterFaqs = () => {
        const query = normalize(input.value);
        let visible = 0;
        items.forEach((item) => {
          const matched = !query || normalize(item.textContent || '').includes(query);
          item.hidden = !matched;
          if (matched) visible += 1;
        });
        sections.forEach((section) => {
          section.hidden = !section.querySelector('[data-faq-item]:not([hidden])');
        });
        empty.hidden = visible !== 0;
        status.textContent = query ? `검색 결과 ${visible}개 질문이 있습니다.` : `전체 ${items.length}개 질문을 확인할 수 있습니다.`;
        clear.hidden = !query;
      };
      input.addEventListener('input', filterFaqs);
      clear.addEventListener('click', () => { input.value = ''; filterFaqs(); input.focus(); });
      filterFaqs();
    })();
  </script>
</BaseLayout>

<style>
  .consulting-faq-answer { padding: 0 26px 24px; }
  .consulting-faq-answer p { margin: 0; padding: 0; font-size: 1rem; line-height: 1.8; overflow-wrap: anywhere; }
  .consulting-faq-answer p + p { margin-top: 12px; }
  .consulting-faq-answer .direct-answer { color: #1d1d1f; font-weight: 650; }
  .consulting-faq-answer a { display: inline-block; padding: 10px 0; color: #0066cc; text-underline-offset: 3px; }
  .consulting-faq-item summary:focus-visible, .common-faq-item summary:focus-visible { outline: 3px solid #0066cc; outline-offset: -4px; }
  .consulting-faq-answer a:focus-visible { outline: 3px solid #0066cc; outline-offset: 3px; }
  @media (max-width: 600px) {
    .consulting-faq-answer { padding: 0 20px 22px; }
  }
</style>
