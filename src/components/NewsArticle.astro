---
import BaseLayout from '../layouts/BaseLayout.astro';
const { article } = Astro.props;
const articleJsonLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: article.title, description: article.summary,
  datePublished: article.publishedAt, dateModified: article.modifiedAt,
  inLanguage: 'ko-KR', mainEntityOfPage: new URL(article.href, Astro.site).toString(),
  author: { '@type': 'Organization', name: '케이잡스 K·JOBS' },
  publisher: { '@id': 'https://www.careerservice.co.kr/#organization' },
  about: [article.category], citation: article.sources?.map(source => source.url) ?? [article.sourceUrl],
};
---
<BaseLayout title={article.title} description={article.summary} jsonLd={articleJsonLd}>
  <article class="policy-article">
    <header class="policy-article-header">
      <nav class="policy-breadcrumb" aria-label="현재 위치">
        <a href="/news-trends/">뉴스·동향</a><span aria-hidden="true">/</span><span>{article.category}</span>
      </nav>
      <p class="ty-comment">{article.category}</p>
      <h1>{article.title}</h1>
      <p class="ty-lead">{article.summary}</p>
      <div class="policy-date-row"><span>원자료 발표 <time datetime={article.sourceDate}>{article.sourceDate.replaceAll('-', '.')}</time></span></div>
    </header>
    {article.legalStage && <p class="legal-stage"><strong>자료의 단계</strong><br />{article.legalStage}</p>}
    {article.sections.map(section => (
      <section class="policy-article-section">
        <h2>{section.heading}</h2>
        {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
      </section>
    ))}
    <section class="policy-source-box" aria-labelledby="source-title">
      <h2 id="source-title">자료 출처</h2>
      <dl>
        <div><dt>원자료</dt><dd>{article.sourceTitle}</dd></div>
        <div><dt>발표기관</dt><dd>{article.source}</dd></div>
        <div><dt>발표일</dt><dd>{article.sourceDate}</dd></div>
        <div><dt>확인 기준일</dt><dd>{article.checkedAt}</dd></div>
      </dl>
      <div class="policy-source-actions">{(article.sources ?? [{label: '원문 확인', url: article.sourceUrl}]).map(source => <a class="ty-inline-link" href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a>)}</div>
    </section>
    {article.relatedLinks?.length > 0 && <section class="policy-article-section"><h2>함께 읽기</h2>{article.relatedLinks.map(link => <p><a class="ty-inline-link" href={link.url}>{link.label}</a></p>)}</section>}
    <div class="policy-actions"><a class="btn secondary" href="/news-trends/">뉴스·동향 목록</a></div>
  </article>
</BaseLayout>
<style>
  .legal-stage { padding: 16px 20px; border-left: 3px solid #0066cc; background: #f5f5f7; font-size: 14px; line-height: 1.8; margin: 0 0 32px; }
</style>
