---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const link = (path: string) => `${base}${path}`;
---
<div class="home05">
  <section class="home05-hero">
    <div class="home05-wrap">
      <p class="home05-kicker">재취업지원서비스 시행지원</p>
      <h1>
        <span>기업의 제도 운영과</span>
        <span>중장년의 경력설계</span>
      </h1>
      <div class="home05-ribbon home05-glass-ribbon" aria-hidden="true">
        <svg class="home05-ribbon-core" viewBox="0 0 760 208" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="rear" x1="0" y1=".85" x2="1" y2=".15" gradientUnits="objectBoundingBox">
              <stop stop-color="#547192"/>
              <stop offset=".22" stop-color="#bbdded"/>
              <stop offset=".47" stop-color="#76a5b7"/>
              <stop offset=".62" stop-color="#36537a"/>
              <stop offset=".82" stop-color="#91c7e0"/>
              <stop offset="1" stop-color="#d7e7f5"/>
            </linearGradient>
            <linearGradient id="face" x1="0" y1=".8" x2="1" y2=".2">
              <stop stop-color="#98c6d9"/>
              <stop offset=".19" stop-color="#d4f4f4"/>
              <stop offset=".34" stop-color="#93e2de"/>
              <stop offset=".48" stop-color="#287a9b"/>
              <stop offset=".62" stop-color="#556ead"/>
              <stop offset=".8" stop-color="#a7b6eb"/>
              <stop offset="1" stop-color="#e6eafa"/>
            </linearGradient>
            <linearGradient id="edge">
              <stop stop-color="#388595"/>
              <stop offset=".27" stop-color="#efffff"/>
              <stop offset=".57" stop-color="#a9cde3"/>
              <stop offset=".86" stop-color="#fbfcff"/>
              <stop offset="1" stop-color="#8c99c4"/>
            </linearGradient>
            <radialGradient id="shade">
              <stop stop-color="#8eacba" stop-opacity=".39"/>
              <stop offset="1" stop-color="#b7c8d0" stop-opacity="0"/>
            </radialGradient>
          </defs>
          <ellipse cx="388" cy="184" rx="249" ry="13" fill="url(#shade)"/>
          <path d="M65 117C62 43 166 13 275 43C359 66 419 124 508 136C579 147 661 115 697 81C702 131 610 177 525 169C416 161 348 99 267 74C176 46 95 63 65 117Z" fill="url(#rear)" stroke="#7094aa" stroke-width="1"/>
          <path d="M65 117C83 174 195 178 283 140C365 105 435 44 539 27C622 13 691 31 697 81C670 48 608 45 546 58C455 77 389 138 289 167C182 199 73 179 65 117Z" fill="url(#face)" stroke="url(#edge)" stroke-width="2.5"/>
          <path d="M68 124C100 174 195 176 282 140C374 101 439 42 541 26C616 15 674 28 693 64" fill="none" stroke="url(#edge)" stroke-width="2.5"/>
          <path d="M70 125C97 157 169 167 227 157M510 67C596 38 657 45 683 65" fill="none" stroke="white" opacity=".8" stroke-width="1.4"/>
        </svg>
      </div>
      <nav class="home05-jump" aria-label="서비스 안내 바로가기">
        <a href="#biz">기업컨설팅 안내 ↓</a>
        <a href="#career">커리어플래닝 안내 ↓</a>
      </nav>
    </div>
  </section>
  <section class="home05-services home05-wrap" aria-labelledby="choose">
    <div class="home05-sectionhead">
      <h2 id="choose">어떤 지원이 필요하신가요?</h2>
      <a class="home05-guide" href={link('career-support/')}>서비스 전체 안내&nbsp; ›</a>
    </div>
    <div class="home05-grid">
      <article id="biz" class="home05-tile" tabindex="-1">
        <p class="home05-label">
          <span class="home05-business-name">재취업지원서비스 기업컨설팅</span>
          <a class="home05-name-detail" href={link('business-consulting/')} aria-label="재취업지원서비스 기업컨설팅 자세히 보기">재취업지원서비스 기업컨설팅</a>
        </p>
        <h3>우리 회사에 맞는 운영 방법을 찾으려면</h3>
        <p class="home05-intro">회사 상황을 살펴보고, 담당자가 재취업지원서비스를 직접 운영하고 개선할 수 있도록 절차와 기준을 함께 정합니다.</p>
        <ol class="home05-flow" aria-label="기업컨설팅 주요 과정">
          <li>현황 진단</li>
          <li>운영체계 설계</li>
          <li>파일럿 검증</li>
          <li>자체 시행</li>
        </ol>
        <div class="home05-decision">
          <p>2026년 기업컨설팅은 6차까지 모집이 종료되었습니다.</p>
          <a class="home05-btn" href={link('contact/?preset=business-next-year#consultation-request')}>차년도 참여 준비 상담받기&nbsp; ›</a>
          <a class="home05-detail-link" href={link('business-consulting/')} aria-label="재취업지원서비스 기업컨설팅 자세히 보기">기업컨설팅 자세히 보기</a>
        </div>
      </article>
      <article id="career" class="home05-tile" tabindex="-1">
        <p class="home05-label">커리어플래닝서비스</p>
        <h3>지금까지의 경험으로 다음 일을 준비하려면</h3>
        <p class="home05-intro">상담사와 함께 해 온 일과 잘하는 일을 짚어 보고, 앞으로 맡고 싶은 역할과 이를 준비할 방법을 정합니다.</p>
        <ol class="home05-flow" aria-label="커리어플래닝 주요 과정">
          <li>참여 요건 확인</li>
          <li>경력진단</li>
          <li>상담 진행</li>
          <li>실행계획 정리</li>
        </ol>
        <div class="home05-decision">
          <p>재직자 직접 신청 · 기업 일괄 신청</p>
          <a class="home05-btn" href={link('career-planning/')}>참여 요건과 신청 방법 보기&nbsp; ›</a>
        </div>
      </article>
    </div>
  </section>
</div>
